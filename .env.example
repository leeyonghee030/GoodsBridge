# DB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goodsbridge
DB_USERNAME=goodsbridge
DB_PASSWORD=changeme

# JWT
JWT_SECRET=changeme-use-a-long-random-string
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=1209600000

# Gemini (Spring AI)
GEMINI_API_KEY=changeme
# 선택: 쓸 모델 이름 (생략하면 gemini-3.1-flash-lite, 응답이 빨라서 채팅에 맞다). 404 'no longer available'이 나오면 다른 모델로 바꾼다
# GEMINI_MODEL=gemini-3.1-flash-lite
# 응답 속도용 사고 수준(MINIMAL, LOW, MEDIUM, HIGH). 기본 LOW. 모델이 지원하지 않아 오류가 나면 THINKING_LEVEL_UNSPECIFIED
# GEMINI_THINKING_LEVEL=LOW

# PortOne
PORTONE_API_SECRET=changeme
PORTONE_STORE_ID=changeme
PORTONE_CHANNEL_KEY=changeme

# 카카오 로그인 (Kakao Developers에서 발급)
KAKAO_CLIENT_ID=changeme
KAKAO_CLIENT_SECRET=changeme
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

MAIL_USERNAME=
MAIL_PASSWORD=

# 입점 신청 체인점 코드 (미설정 시 기본값 GB-CHAIN-2026)
CHAIN_CODE=

# 시연용 계정 전환 버튼 (true일 때만 /demo/* 활성화, 운영에서는 설정하지 말 것)
APP_DEMO_ENABLED=
