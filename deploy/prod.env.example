# 배포 서버(docker-compose.prod.yml)용 .env 예시. 서버의 프로젝트 폴더에 .env 로 복사해 값을 채운다. 이 파일/.env 는 깃에 올리지 않는다.

# 사이트 주소(도메인만, https:// 없이). Caddy 가 이 주소로 HTTPS 인증서를 자동 발급한다.
# 도메인이 없으면 서버 공인 IP 를 점 대신 - 로 쓴 무료 주소를 쓴다. 예) 공인 IP 129.154.1.2 → 129-154-1-2.nip.io
DOMAIN=changeme.example.com

# DB (DB_HOST/DB_PORT 는 compose 가 mysql 컨테이너로 고정하므로 적지 않아도 된다)
DB_NAME=goodsbridge
DB_USERNAME=goodsbridge
DB_PASSWORD=changeme-long-random

# JWT (서버에서 새로 만든 긴 무작위 문자열)
JWT_SECRET=changeme-use-a-long-random-string
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=1209600000

# Gemini
GEMINI_API_KEY=changeme

# PortOne (테스트 채널 키)
PORTONE_API_SECRET=changeme
PORTONE_STORE_ID=changeme
PORTONE_CHANNEL_KEY=changeme

# 카카오 로그인: https://사이트주소/oauth2/kakao 를 Kakao Developers 의 Redirect URI 에도 똑같이 등록해야 한다
KAKAO_CLIENT_ID=changeme
KAKAO_CLIENT_SECRET=changeme
KAKAO_REDIRECT_URI=https://changeme.example.com/oauth2/kakao

MAIL_USERNAME=
MAIL_PASSWORD=

# 시연용 계정 전환 버튼(/demo/*). 심사하는 사람이 데모 계정으로 바로 둘러보게 하려면 true.
# true 면 교환 보증금 결제를 건너뛰는 시연용 동작이 켜지고, 서버를 켤 때와 매일 새벽 4시에 시연 데이터가 새로 만들어진다
APP_DEMO_ENABLED=true

# 메모리가 작은 서버용 JVM 옵션 (기본값은 Dockerfile 에 있다. 바꿀 때만 주석을 풀어 쓴다)
# JAVA_OPTS=-Xmx512m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Seoul
