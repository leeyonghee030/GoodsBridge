{{> fragments/header}}

<style>
/* 내 정보: 프로필 요약 + 수정은 창(모달)으로 */
.profile-view { display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem 0.5rem; }
.profile-view .profile-avatar-image { width: 112px; height: 112px; flex: none; }
.profile-view-info { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
.profile-view-info strong { font-size: 1.25rem; }
.profile-view-info span { font-size: 0.88rem; color: var(--color-muted); word-break: break-all; }
.profile-view-info .write-link { align-self: flex-start; width: auto; margin-top: 0.6rem; }
.profile-view-actions { display: flex; justify-content: flex-end; align-items: center; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
.profile-view-actions .profile-danger-zone { margin: 0; }
.profile-view-actions .profile-danger-zone button { display: inline-block; width: auto; padding: 0.5rem 1rem; font-size: 0.84rem; white-space: nowrap; }
.modal-card.profile-modal { max-width: 820px; }
.profile-view-info button.shop-apply-link { align-self: flex-start; width: auto; padding: 0; margin: 0.1rem 0 0; background: none; border: 0; border-radius: 0; font: inherit; font-size: 0.74rem; font-weight: 400; color: var(--color-muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
.profile-view-info button.shop-apply-link:hover { background: none; color: var(--color-text); }
@media (max-width: 640px) { .profile-view-info button.shop-apply-link { align-self: center; } }
.shop-sub-days { display: flex; flex-direction: column; gap: 0.5rem; margin: 0.8rem 0; }
.shop-sub-days label { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 0.7rem 0.9rem; border: 1px solid var(--color-border); border-radius: 10px; font-size: 0.9rem; color: var(--color-text); cursor: pointer; }
.shop-sub-days label:has(input:checked) { border-color: var(--color-dark); }
.shop-sub-days input { width: auto; margin: 0; }
.shop-sub-days span { color: var(--color-muted); font-size: 0.84rem; }
#shop-apply-status, #shop-sub-status { font-size: 0.74rem; color: var(--color-muted); margin: 0.2rem 0 0; }
.shop-apply-form { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1rem; }
.shop-apply-form label { font-size: 0.84rem; color: var(--color-muted); }
@media (max-width: 640px) { .profile-view { flex-direction: column; text-align: center; } .profile-view-info .write-link { align-self: center; } }
</style>

<div class="container my-card">
<nav class="my-tabs">
    <a href="/update" class="active">내 정보</a>
    <a href="/my/exchange">교환 내역</a>
    <a href="/my/purchases">구매 내역</a>
    <a href="/my/events">이벤트 내역</a>
    <a href="/my/auctions">경매 내역</a>
</nav>

<div class="profile-view">
    {{#user.profileImage}}<img src="{{user.profileImage}}" alt="" class="profile-avatar-image">{{/user.profileImage}}
    {{^user.profileImage}}<div class="profile-avatar-image profile-avatar-empty"><span>프로필 사진 없음</span></div>{{/user.profileImage}}
    <div class="profile-view-info">
        <strong>{{#user.nickname}}{{user.nickname}}{{/user.nickname}}</strong>
        <span>{{user.email}}</span>
        <button type="button" class="write-link" id="open-profile-edit">회원 정보 수정</button>
        <button type="button" class="shop-apply-link" id="open-shop-apply" hidden>입점 신청</button>
        <p id="shop-apply-status" hidden></p>
        <p id="shop-sub-status" hidden></p>
        <button type="button" class="shop-apply-link" id="open-shop-sub" hidden>구독 신청</button>
    </div>
</div>
</div>

<!-- 입점 신청 창 -->
<div class="modal-backdrop" id="shop-apply-modal" hidden>
<div class="modal-card">
<button type="button" class="modal-close" id="close-shop-apply">✕</button>
<h1>입점 신청</h1>
<p class="pu-note" style="font-size:0.84rem;color:var(--color-muted);">체인점 본사에서 받은 코드가 필요해요. 관리자가 승인하면 구독 결제 후 상품·이벤트·경매를 열 수 있어요.</p>
<form id="shop-apply-form" class="shop-apply-form">
    <label for="shop-chain-code">체인점 코드</label>
    <input id="shop-chain-code" type="text" placeholder="본사에서 받은 코드" autocomplete="off" required>
    <label for="shop-name">가게 이름</label>
    <input id="shop-name" type="text" maxlength="50" required>
    <label for="shop-region">지역</label>
    <input id="shop-region" type="text" placeholder="예: 서울" required>
    <label for="shop-address">주소</label>
    <input id="shop-address" type="text" required>
    <button type="submit">신청하기</button>
    <p id="shop-apply-message" class="form-message"></p>
</form>
</div>
</div>

<!-- 구독 신청 창 -->
<div class="modal-backdrop" id="shop-sub-modal" hidden>
<div class="modal-card">
<button type="button" class="modal-close" id="close-shop-sub">✕</button>
<h1>구독 신청</h1>
<p style="font-size:0.84rem;color:var(--color-muted);" id="shop-sub-desc"></p>
<div class="shop-sub-days" id="shop-sub-days">
    <label><span style="color:var(--color-text);"><input type="radio" name="shop-sub-day" value="30" checked> 30일</span><span>30,000원</span></label>
    <label><span style="color:var(--color-text);"><input type="radio" name="shop-sub-day" value="90"> 90일</span><span>90,000원</span></label>
    <label><span style="color:var(--color-text);"><input type="radio" name="shop-sub-day" value="365"> 365일</span><span>365,000원</span></label>
</div>
<button type="button" id="shop-sub-pay">결제하고 구독</button>
<p id="shop-sub-message" class="form-message"></p>
</div>
</div>

<!-- 회원 정보 수정 창 -->
<div class="modal-backdrop" id="profile-edit-modal" hidden>
<div class="modal-card profile-modal">
<button type="button" class="modal-close" id="close-profile-edit">✕</button>
<h1>회원 정보 수정</h1>

<div class="profile-grid">
    <div class="profile-avatar-col">
        <!--   프로필 이미지 있을 경우              -->
        {{#user.profileImage}}
            <img src="{{user.profileImage}}" alt="" class="profile-avatar-image">
            <form action="/user/profile-image/delete" method="post" class="inline-form">
                <button type="submit" class="link-button"
                        onclick="event.preventDefault(); const f = this.form; gbConfirm('사진을 삭제하시겠습니까?').then(ok => { if (ok) f.submit(); });">프로필 사진 삭제
                </button>
            </form>
        {{/user.profileImage}}
        <!--   프로필 이미지 없을 경우              -->
        {{^user.profileImage}}
            <div class="profile-avatar-image profile-avatar-empty">
                <span>프로필 사진 없음</span>
            </div>
        {{/user.profileImage}}
    </div>

    <form action="/api/update" method="post" enctype="multipart/form-data" class="profile-form">
        <div class="profile-form-grid">
            <div class="profile-field-row">
                <label for="email">이메일</label>
                <input id="email" type="text" value="{{user.email}}" readonly>
            </div>
            <div class="profile-field-row">
                <label for="nickname">닉네임</label>
                <input
                    id="nickname"
                    type="text"
                    name="nickname"
                    value="{{#user.nickname}}{{user.nickname}}{{/user.nickname}}"
                    required
                >
            </div>

            <!--   전화번호/주소는 보여주기용 - User 엔티티에 컬럼이 없어 서버로 전송하지 않음              -->
            <div class="profile-field-row">
                <label for="phone-num1">휴대전화</label>
                <div class="phone-row">
                    <select id="phone-prefix">
                        <option value="010">010</option>
                        <option value="011">011</option>
                        <option value="016">016</option>
                        <option value="017">017</option>
                        <option value="018">018</option>
                        <option value="019">019</option>
                    </select>
                    <span class="field-dash">-</span>
                    <input id="phone-num1" type="text" maxlength="4" placeholder="0000">
                    <span class="field-dash">-</span>
                    <input id="phone-num2" type="text" maxlength="4" placeholder="0000">
                </div>
            </div>

            <div class="profile-field-row">
                <label for="profileImage">프로필 이미지</label>
                <input
                    id="profileImage"
                    type="file"
                    name="profileImage"
                    accept="image/**"
                >
            </div>

            <div class="profile-field-row profile-field-full">
                <label for="postcode">주소</label>
                <div class="address-postcode-row">
                    <input id="postcode" type="text" placeholder="우편번호" readonly>
                    <button type="button">주소검색</button>
                </div>
                <div class="address-base-row">
                    <input id="address-base" type="text" placeholder="기본주소" readonly>
                    <input id="address-detail" type="text" placeholder="상세주소 (선택 입력 가능)">
                </div>
            </div>
        </div>

        <button type="submit">수정하기</button>
    </form>
</div>
<div class="profile-view-actions">
    <div class="profile-danger-zone">
        <form action="/api/withdraw" method="post">
            <button type="submit" class="secondary"
                    onclick="event.preventDefault(); const f = this.form; gbConfirm('정말 탈퇴할까요?\n탈퇴하면 계정을 다시 사용할 수 없어요.').then(ok => { if (ok) f.submit(); });">회원탈퇴</button>
        </form>
    </div>
</div>
</div>
</div>

<script>
(() => {
    const modal = document.getElementById('profile-edit-modal');
    document.getElementById('open-profile-edit').addEventListener('click', () => { modal.hidden = false; });
    document.getElementById('close-profile-edit').addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', ev => { if (ev.target === modal) modal.hidden = true; });

    // ===== 입점 신청: 내 가게 상태에 따라 버튼/안내가 바뀐다 =====
    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const applyBtn = document.getElementById('open-shop-apply');
    const applyStatus = document.getElementById('shop-apply-status');
    const applyModal = document.getElementById('shop-apply-modal');
    const applyForm = document.getElementById('shop-apply-form');
    const applyMessage = document.getElementById('shop-apply-message');

    async function loadShopStatus() {
        const res = await fetch('/api/shops/me', { credentials: 'same-origin' });
        const shops = res.ok ? ((await res.json()).content || []) : [];
        const approved = shops.find(s => s.status === 'APPROVED');
        const pending = shops.find(s => s.status === 'PENDING');
        applyBtn.hidden = true;
        applyStatus.hidden = false;
        subStatus.hidden = true; subBtn.hidden = true; shopForSub = null;
        if (approved) { applyStatus.textContent = `입점 완료 · ${approved.name}`; shopForSub = approved; loadSubscription(approved); }
        else if (pending) applyStatus.textContent = `입점 승인 대기 중 · ${pending.name}`;
        else if (shops.some(s => s.status === 'REJECTED')) { applyStatus.textContent = '입점 신청이 거절되었어요. 내용을 확인하고 다시 신청해 주세요.'; applyBtn.hidden = false; applyBtn.textContent = '다시 신청'; }
        else { applyStatus.hidden = true; applyBtn.hidden = false; }
    }
    // ===== 가게 구독: 승인된 가게의 구독 기간 표시 + 신청/연장 =====
    const PRICE_PER_DAY = 1000;   // ShopSubscriptionService.PRICE_PER_DAY 와 같은 값 (서버가 다시 계산해서 검증한다)
    const subStatus = document.getElementById('shop-sub-status');
    const subBtn = document.getElementById('open-shop-sub');
    const subModal = document.getElementById('shop-sub-modal');
    const subMessage = document.getElementById('shop-sub-message');
    const skipPayment = '{{skipPayment}}' === 'true' && window.gbPaySkip();
    let shopForSub = null;
    let subActive = false;
    const ymd = iso => new Date(iso).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });

    async function loadSubscription(shop) {
        // 구독 정보를 못 불러와도 구독 신청 버튼은 항상 보여준다 (구독 전 상태로 취급)
        subStatus.hidden = false; subBtn.hidden = false;
        subActive = false;
        let res = null;
        try { res = await fetch(`/api/shops/${shop.id}/subscription`, { credentials: 'same-origin' }); } catch (e) { /* 구독 전으로 표시 */ }
        if (!res || !res.ok) { subStatus.textContent = '구독 전 · 구독하면 상품·이벤트·경매를 열 수 있어요.'; subBtn.textContent = '구독 신청'; return; }
        const sub = await res.json();
        const left = Math.round((new Date(...String(sub.endDate).split('-').map((n, i) => Number(n) - (i === 1 ? 1 : 0))) - new Date(new Date().toDateString())) / 86400000);
        if (sub.status === 'ACTIVE' && left >= 0) {
            subActive = true;
            subStatus.textContent = `구독 중 · ${ymd(sub.endDate)}까지 (D-${left})`;
            subBtn.textContent = '구독 연장';
        } else {
            subStatus.textContent = sub.status === 'CANCELLED' ? '구독이 취소되었어요.' : `구독 만료 · ${ymd(sub.endDate)}`;
            subBtn.textContent = '구독 재개';
        }
    }

    subBtn.addEventListener('click', () => {
        subMessage.textContent = '';
        document.getElementById('shop-sub-desc').textContent = subActive ? '현재 만료일 뒤로 이어서 연장돼요.' : '결제하면 오늘부터 구독이 시작돼요.';
        subModal.hidden = false;
    });
    document.getElementById('close-shop-sub').addEventListener('click', () => { subModal.hidden = true; });
    subModal.addEventListener('click', ev => { if (ev.target === subModal) subModal.hidden = true; });

    document.getElementById('shop-sub-pay').addEventListener('click', async ev => {
        const btn = ev.target;
        const days = Number(document.querySelector('input[name="shop-sub-day"]:checked').value);
        const amount = days * PRICE_PER_DAY;
        const fail = text => { subMessage.textContent = text; subMessage.className = 'form-message error'; btn.disabled = false; };
        if (!skipPayment && !window.PortOne) { fail('포트원 SDK를 불러오지 못했습니다.'); return; }
        btn.disabled = true;
        subMessage.textContent = skipPayment ? '구독하는 중입니다. (데모: 결제 생략)' : '결제창을 여는 중입니다.';
        subMessage.className = 'form-message';
        try {
            let paymentId = `demo-pay-${crypto.randomUUID()}`;
            if (!skipPayment) {
                const result = await PortOne.requestPayment({
                    storeId: '{{portoneStoreId}}', channelKey: '{{portoneChannelKey}}',
                    paymentId: `goodsbridge-${crypto.randomUUID()}`,
                    orderName: `${shopForSub.name} 구독 ${days}일`, totalAmount: amount, currency: 'KRW', payMethod: 'CARD'
                });
                if (result.code) throw new Error(result.message || '결제가 취소되었습니다.');
                paymentId = result.paymentId;
            }
            const res = await fetch(`/api/shops/${shopForSub.id}/subscription`, {
                method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentId, amount, days })
            });
            if (!res.ok) {
                let text = '구독 처리에 실패했습니다.';
                try { text = JSON.parse(await res.text()).message || text; } catch (e) {}
                throw new Error(text);
            }
            subModal.hidden = true; btn.disabled = false;
            await loadSubscription(shopForSub);
        } catch (error) { fail(error.message); }
    });

    loadShopStatus().catch(() => {});

    applyBtn.addEventListener('click', () => { applyMessage.textContent = ''; applyModal.hidden = false; });
    document.getElementById('close-shop-apply').addEventListener('click', () => { applyModal.hidden = true; });
    applyModal.addEventListener('click', ev => { if (ev.target === applyModal) applyModal.hidden = true; });

    applyForm.addEventListener('submit', async ev => {
        ev.preventDefault();
        const btn = applyForm.querySelector('button[type="submit"]');
        btn.disabled = true;
        const res = await fetch('/api/shops', {
            method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: document.getElementById('shop-name').value.trim(),
                region: document.getElementById('shop-region').value.trim(),
                address: document.getElementById('shop-address').value.trim(),
                chainCode: document.getElementById('shop-chain-code').value.trim()
            })
        });
        if (!res.ok) {
            let text = '입점 신청에 실패했습니다.';
            try { text = JSON.parse(await res.text()).message || text; } catch (e) {}
            applyMessage.textContent = text; applyMessage.className = 'form-message error'; btn.disabled = false; return;
        }
        applyModal.hidden = true; applyForm.reset(); btn.disabled = false;
        await loadShopStatus();
    });
})();
</script>

<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>
{{> fragments/footer}}
