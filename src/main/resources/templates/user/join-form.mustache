{{> fragments/header}}

<style>
    /* 회원가입 카드: 로그인 카드(360px)보다 넓게 */
    .container.join-card { max-width: 520px; padding: 2.5rem 2.5rem 2rem; }
    .join-card h1 { text-align: center; margin: 0 0 1.75rem; }
    .join-card label { display: block; margin-bottom: 0.35rem; font-size: 0.85rem; color: var(--color-muted); }
    .join-card .join-field,
    .join-card form p { margin: 0 0 1.1rem; }
    .join-card .email-verify-row { flex-wrap: nowrap; gap: 0.5rem; }
    .join-card .email-verify-row input { min-width: 0; }
    .join-card .email-verify-row button[type="button"] { padding: 0.75rem 1rem; font-size: 0.85rem; }
    .join-card #code-box { margin: 0 0 1.1rem; }
    .join-card .input-group { display: flex; gap: 0.5rem; }
    .join-card .input-group input { flex: 1; min-width: 0; }
    .join-card .input-group button[type="button"] { width: auto; white-space: nowrap; padding: 0.75rem 1.1rem; font-size: 0.85rem; }
    .join-card .form-text { margin-top: 0.4rem; font-size: 0.8rem; }
    .join-card #join-submit-btn { margin-top: 0.75rem; }
    .join-card .join-footer { margin: 1.5rem 0 0; text-align: center; font-size: 0.85rem; color: var(--color-muted); }
    @media (max-width: 640px) {
        .container.join-card { padding: 1.5rem 1.25rem; }
        .join-card .email-verify-row { flex-wrap: wrap; }
        .join-card .email-verify-row button[type="button"] { width: 100%; }
    }
</style>

<div class="container join-card">
<h1>회원가입</h1>

<form action="/api/join" method="post" onsubmit="return checkVerify()">
    <div class="join-field">
        <label for="email-id">이메일</label>
        <div class="email-verify-row">
            <input id="email-id" type="text" placeholder="이메일 아이디" aria-label="이메일 아이디" required>
            <span class="email-at">@</span>
            <input id="email-domain" type="text" list="email-domain-list" placeholder="gmail.com" aria-label="도메인" required>
            <datalist id="email-domain-list">
                <option value="naver.com">
                <option value="gmail.com">
                <option value="daum.net">
            </datalist>
            <input type="hidden" id="email" name="email">
            <button type="button" class="btn btn-outline-secondary" id="send-btn" onclick="sendCode()">
                인증번호 전송
            </button>
        </div>
    </div>

    <div class="mb-3" id="code-box" style="display: none">
        <label for="code">인증번호</label>
        <div class="input-group">
            <input type="text" id="code" placeholder="인증번호 입력" maxlength="10">
            <button type="button" id="verify-btn" onclick="verifyCode()">확인</button>
        </div>
        <div id="msg" class="form-text"></div>
    </div>

    <p>
        <label for="nickname">닉네임</label>
        <input id="nickname" type="text" name="nickname" required>
    </p>

    <p>
        <label for="password">비밀번호 (8~20자)</label>
        <input id="password" type="password" name="password"
               minlength="8" maxlength="20" autocomplete="new-password" required>
    </p>

    <p>
        <label for="password-confirm">비밀번호 확인</label>
        <input id="password-confirm" type="password" minlength="8" maxlength="20" autocomplete="new-password" required>
    </p>
    <p id="password-match-msg" class="form-message"></p>

    <p>
        <label for="phoneNumber">전화번호</label>
        <input type="tel"
               id="phoneNumber"
               name="phoneNumber"
               maxlength="13"
               placeholder="전화번호 (선택)">
    </p>

    <button type="submit" id="join-submit-btn">가입하기</button>
</form>

<p class="join-footer">이미 계정이 있나요? <a href="/login">로그인</a></p>
</div>

<script>

    (() => {
        const input = document.getElementById('phoneNumber');

        if (!input) return;

        // 숫자만 추출
        const getDigits = (value) => value.replace(/\D/g, '');

        // 전화번호 포맷
        const formatPhoneNumber = (digits) => {
            digits = digits.slice(0, 11);

            // 서울 지역번호 02
            if (digits.startsWith('02')) {
                if (digits.length <= 2) return digits;
                if (digits.length <= 5) {
                    return digits.slice(0, 2) + '-' + digits.slice(2);
                }
                if (digits.length <= 9) {
                    return digits.slice(0, 2) + '-' +
                        digits.slice(2, 5) + '-' +
                        digits.slice(5);
                }
                return digits.slice(0, 2) + '-' +
                    digits.slice(2, 6) + '-' +
                    digits.slice(6);
            }

            // 휴대폰 및 기타 지역번호
            if (digits.length <= 3) return digits;

            if (digits.length <= 7) {
                return digits.slice(0, 3) + '-' + digits.slice(3);
            }

            if (digits.length <= 10) {
                return digits.slice(0, 3) + '-' +
                    digits.slice(3, 6) + '-' +
                    digits.slice(6);
            }

            return digits.slice(0, 3) + '-' +
                digits.slice(3, 7) + '-' +
                digits.slice(7);
        };

        // 커서 위치 보정
        const restoreCursor = (element, digitCount) => {
            let position = 0;
            let count = 0;

            // 커서 앞의 숫자 개수만큼 포맷된 문자열에서 이동
            while (position < element.value.length && count < digitCount) {
                if (/\d/.test(element.value[position])) {
                    count++;
                }
                position++;
            }

            // 숫자를 모두 찾았으면 뒤에 하이픈이 있는 경우 넘김
            if (element.value[position] === '-') {
                position++;
            }

            element.setSelectionRange(position, position);
        };

        // 입력 및 붙여넣기 시 포맷
        input.addEventListener('input', () => {
            const cursor = input.selectionStart ?? input.value.length;

            // 현재 커서 앞에 있는 숫자의 개수 저장
            const digitCount = getDigits(input.value.slice(0, cursor)).length;

            // 숫자만 추출 후 포맷
            const digits = getDigits(input.value);
            input.value = formatPhoneNumber(digits);

            // 커서 복원
            restoreCursor(input, digitCount);
        });

        // 하이픈 바로 앞/뒤 삭제 시 숫자가 자연스럽게 삭제되도록 처리
        input.addEventListener('keydown', (event) => {
            const start = input.selectionStart;
            const end = input.selectionEnd;

            // 커서가 없거나 선택 영역이 있으면 기본 동작 유지
            if (start === null || end === null || start !== end) return;

            const value = input.value;

            // Backspace: 커서 바로 앞이 하이픈인 경우
            if (event.key === 'Backspace' && value[start - 1] === '-') {
                event.preventDefault();

                // 하이픈 앞의 숫자 삭제
                const deleteIndex = start - 2;

                if (deleteIndex >= 0) {
                    input.value =
                        value.slice(0, deleteIndex) +
                        value.slice(deleteIndex + 1);

                    // 삭제 후 포맷 적용
                    const digits = getDigits(input.value);
                    input.value = formatPhoneNumber(digits);

                    // 커서 복원
                    restoreCursor(input, getDigits(value.slice(0, deleteIndex)).length);
                }
            }

            // Delete: 커서 바로 뒤가 하이픈인 경우
            if (event.key === 'Delete' && value[start] === '-') {
                event.preventDefault();

                // 하이픈 뒤의 숫자 삭제
                const deleteIndex = start + 1;

                if (deleteIndex < value.length) {
                    input.value =
                        value.slice(0, deleteIndex) +
                        value.slice(deleteIndex + 1);

                    // 삭제 후 포맷 적용
                    const digits = getDigits(input.value);
                    input.value = formatPhoneNumber(digits);

                    // 커서 복원
                    restoreCursor(input, getDigits(value.slice(0, start)).length);
                }
            }
        });
    })();


    // 인증 완료 여부 (화면 안 내용, 실제 검사는 서버의 세션으로 함
    let isEmailVerified = false;
    let count = 5;

    function updateEmailValue() {
        const id = document.querySelector("#email-id").value.trim();
        const domain = document.querySelector("#email-domain").value.trim();
        document.querySelector("#email").value = id && domain ? `${id}@${domain}` : "";
    }
    document.querySelector("#email-id").addEventListener("input", updateEmailValue);
    document.querySelector("#email-domain").addEventListener("input", updateEmailValue);
    updateEmailValue();

    function checkPasswordMatch() {
        const password = document.querySelector("#password").value;
        const passwordConfirm = document.querySelector("#password-confirm").value;
        const msg = document.querySelector("#password-match-msg");
        if (!passwordConfirm) { msg.textContent = ""; return; }
        if (password === passwordConfirm) {
            msg.textContent = "비밀번호가 일치합니다.";
            msg.className = "form-message";
        } else {
            msg.textContent = "비밀번호가 일치하지 않습니다.";
            msg.className = "form-message error";
        }
    }
    document.querySelector("#password").addEventListener("input", checkPasswordMatch);
    document.querySelector("#password-confirm").addEventListener("input", checkPasswordMatch);

    // 1. 인증 번호 전송
    async function sendCode() {
        const sendBtn = document.querySelector("#send-btn");
        if (sendBtn.disabled) return;
        updateEmailValue();
        const email = document.querySelector("#email").value; // 사용자 입력 : a@naver.com
        if (!email) {
            alert("이메일을 입력해주세요");
            return;
        }

        // 메일 발송은 몇 초 걸리므로, 그 동안 버튼을 막아 중복 요청을 방지 한다 (중요!)
        sendBtn.disabled = true;
        sendBtn.innerText = "전송 중 ...";

        try {
            const response = await fetch("/api/email/send", {
                method: "POST",
                headers: {"Content-Type": "application/json"}, // 바디가 JSON 이라고 알림
                body: JSON.stringify({email: email})            // 객체 --> JSON 문자열로 변환 됨
            })

            const result = await response.json()    // JSON 응답 --> 자바스크립트 객체로 변환 됨
            // 백엔드 개발자와 어떤 식으로 요청을 보내고 어떤 식으로 응답이 올지 확인 해야 한다.
            // 백엔드 API 에서 key : message 로 내려 보내기로 했다
            // alert(result.message);
            if (!response.ok) {
                alert(result.message);
                return;
            }

            document.querySelector("#code-box").style.display = "block";

        } catch (e) {
            alert("서버와 통신하지 못했습니다.")
        } finally {
            sendBtn.disabled = false;
            sendBtn.innerText = "인증번호 전송"
        }
    }

    // 2. 인증번호 확인 전승
    async function verifyCode() {
        const verifyBtn = document.querySelector("#verify-btn");
        if (verifyBtn.disabled) return;
        // 사용자 이메일, 인증 코드 (6자리)
        const email = document.querySelector("#email").value;
        const code = document.querySelector("#code").value;

        if (!code) {
            alert("인증번호를 입력해주세요");
            return;
        }

        verifyBtn.disabled = true;
        try {
            const response = await fetch("/api/email/verify", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({email: email, code: code}) // 객체 --> JSON 으로 변환
            });
            const result = await response.json();   // JSON --> 객체로 변환
            const msgBox = document.querySelector("#msg");
            if (response.ok) {
                isEmailVerified = true;
                msgBox.innerHTML = result.message;  // "인증 되었습니다"
                msgBox.className = "form-text text-success";
                // 인증한 이메일을 화면단에서 바꾸지 못하게 잠금
                document.querySelector("#email-id").disabled = true;
                document.querySelector("#email-domain").disabled = true;
                document.querySelector("#send-btn").disabled = true;
            } else {
                msgBox.textContent = result.message;
                msgBox.className = "form-text text-danger";

                if (response.status === 429) {
                    isEmailVerified = false;
                    document.querySelector("#code-box").style.display = "none";
                    document.querySelector("#code").value = "";
                    document.querySelector("#email-id").disabled = false;
                    document.querySelector("#email-domain").disabled = false;
                    document.querySelector("#send-btn").disabled = false;
                    alert(result.message);
                }
            }
        } catch (e) {
            console.log(e)
            alert("서버와 통신하지 못했습니다");
            return;
        } finally {
            verifyBtn.disabled = false;
        }
    }

    // 3. 회원가입 제출 직전 확인 (false 를 반환하면 제출을 막음)
    function checkVerify() {
        const submitBtn = document.querySelector("#join-submit-btn");
        if (submitBtn.disabled) return false;
        if (!isEmailVerified) {
            alert("이메일 인증을 먼저해주세요")
            return false;
        }
        const password = document.querySelector("#password").value;
        const passwordConfirm = document.querySelector("#password-confirm").value;
        if (password !== passwordConfirm) {
            alert("비밀번호가 일치하지 않습니다");
            return false;
        }
        submitBtn.disabled = true;
        return true;
    }

    function checkCount() {
        if (count >= 5){
            count = 0;

        }
    }

</script>

{{> fragments/footer}}
