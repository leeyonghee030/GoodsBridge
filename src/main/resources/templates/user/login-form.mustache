{{> fragments/header}}

<div class="container">
<h1>로그인</h1>

<form action="/api/login" method="post">
    <p>
        <label for="email" class="sr-only">이메일</label>
        <input id="email" type="email" name="email" placeholder="이메일" required>
    </p>

    <p>
        <label for="password" class="sr-only">비밀번호</label>
        <input id="password" type="password" name="password" placeholder="비밀번호" required>
    </p>

    <label class="checkbox-row">
        <input type="checkbox" name="rememberMe">
        로그인상태유지
    </label>

    <button type="submit">로그인</button>
</form>

<div class="link-row">
    <a href="/join">회원가입</a>
    <a href="/api/kakao-login">카카오 로그인</a>
</div>
</div>

{{#loginError}}
<div id="login-error" data-message="{{loginError}}" hidden></div>
<script>
    // 탈퇴한 카카오 계정이면 안내 후 카카오 계정 선택 화면으로 다시 보낸다
    alert(document.getElementById('login-error').dataset.message){{#kakaoRetry}}.then(() => { location.href = '/api/kakao-login?reselect=true'; }){{/kakaoRetry}};
</script>
{{/loginError}}

{{> fragments/footer}}
