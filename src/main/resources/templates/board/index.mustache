{{> fragments/header}}

<section class="page-head">
    <h1>게시판</h1>
    <p>문의와 공지를 올리고 답변을 받아보세요.</p>
</section>

<section class="panel">
    <div class="section-title">
        <h2>전체 글</h2>
        <button type="button" id="open-create">글쓰기</button>
    </div>
    <form id="search-form" style="margin-bottom: 1rem;">
        <label for="keyword-input" class="sr-only">검색</label>
        <input type="text" id="keyword-input" placeholder="제목, 내용 또는 작성자 검색" value="{{keyword}}" style="width: 60%; display: inline-block;">
        <button type="submit" style="width: auto; display: inline-block;">검색</button>
        <button type="button" id="sort-toggle" class="btn-secondary" style="width: auto; display: inline-block;">최신순</button>
    </form>
    <div id="board-list" class="board-list-box">
        {{^boards}}<p class="empty">아직 등록된 게시글이 없습니다.</p>{{/boards}}
        {{#boards}}
        <a class="payment-row" href="/test/board/{{id}}" style="text-decoration: none; color: inherit;">
            <div>
                <strong>{{#isSecret}}🔒 {{/isSecret}}{{title}}</strong>
                <small>작성자: {{authorNickname}} · {{status.description}}</small>
            </div>
            <small class="board-meta"><span class="board-date" data-iso="{{createdAt}}"></span></small>
        </a>
        {{/boards}}
    </div>
    <p id="load-more-status" class="empty" hidden>불러오는 중...</p>
    <button type="button" id="load-more" style="margin-top: 0.75rem;" {{^totalPages}}hidden{{/totalPages}}>더 보기</button>
</section>

<div class="modal-backdrop" id="create-modal" hidden>
    <div class="modal-card">
        <button type="button" class="modal-close" id="close-create">✕</button>
        <h1>게시글 작성</h1>
        <form id="create-form">
            <p><input id="board-title" type="text" placeholder="제목" maxlength="100" autocomplete="off" required></p>
            <p><textarea id="board-content" placeholder="내용을 입력하세요" rows="5" required></textarea></p>
            <p style="position: relative;">
                <input id="item-search" type="text" placeholder="관련 상품 검색 (선택)" autocomplete="off">
                <input id="board-item-id" type="hidden">
                <div id="item-search-results" class="autocomplete-list"></div>
            </p>
            <label class="checkbox-row">
                <input type="checkbox" id="board-secret">
                비밀글로 작성
            </label>
            <button type="submit">등록</button>
        </form>
        <p id="create-message" class="form-message"></p>
    </div>
</div>

<script>
// 서버 에러 응답({"code","message","timestamp"})에서 사용자에게 보여줄 message만 꺼냄
const errorText = async (res, fallback) => {
    const text = await res.text();
    try { return JSON.parse(text).message || fallback; } catch (e) { return text || fallback; }
};

(() => {
    const pageFetch = (path, options = {}) => fetch(path, Object.assign({ credentials: 'same-origin' }, options));
    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const statusLabels = { PENDING: '답변 대기', COMPLETED: '답변 완료' };
    const formatDate = iso => (iso || '').replace('T', ' ').slice(0, 16);

    document.querySelectorAll('.board-date[data-iso]').forEach(el => { el.textContent = formatDate(el.dataset.iso); });

    const userId = {{#userId}}{{userId}}{{/userId}}{{^userId}}null{{/userId}};
    function requireLogin() {
        if (userId !== null) return true;
        alert('로그인이 필요합니다.');
        const loginModal = document.getElementById('login-modal');
        if (loginModal) loginModal.hidden = false;
        return false;
    }

    const keywordInput = document.getElementById('keyword-input');
    const list = document.getElementById('board-list');
    const loadMoreButton = document.getElementById('load-more');
    const loadMoreStatus = document.getElementById('load-more-status');
    let currentKeyword = keywordInput.value.trim();
    let currentPage = 1; // 0페이지는 서버에서 이미 렌더링됨
    let totalPages = {{totalPages}};
    let sortDirection = 'desc'; // 최신순 기본

    function rowHtml(board) {
        return `<a class="payment-row" href="/test/board/${board.id}" style="text-decoration: none; color: inherit;">
            <div>
                <strong>${board.isSecret ? '🔒 ' : ''}${esc(board.title)}</strong>
                <small>작성자: ${esc(board.authorNickname)} · ${esc(statusLabels[board.status] || board.status)}</small>
            </div>
            <small class="board-meta">${formatDate(board.createdAt)}</small>
        </a>`;
    }

    let loadingMore = false;
    async function loadMore() {
        if (loadingMore || currentPage >= totalPages) return;
        loadingMore = true;
        loadMoreStatus.hidden = false;
        const query = new URLSearchParams({ page: currentPage, size: 10, sort: 'id,' + sortDirection });
        if (currentKeyword) query.set('keyword', currentKeyword);
        const res = await pageFetch('/api/boards?' + query.toString());
        loadMoreStatus.hidden = true;
        if (!res.ok) { loadingMore = false; return; }
        const page = await res.json();
        list.insertAdjacentHTML('beforeend', (page.content || []).map(rowHtml).join(''));
        totalPages = page.totalPages;
        currentPage += 1;
        loadMoreButton.hidden = currentPage >= totalPages;
        loadingMore = false;
    }

    // 고정 높이 목록 안에서 맨 아래 근처까지 스크롤하면 다음 글을 자동으로 불러옴
    let listScrollTimer;
    list.addEventListener('scroll', () => {
        // 스크롤하는 동안에만 스크롤바 표시
        list.classList.add('is-scrolling');
        clearTimeout(listScrollTimer);
        listScrollTimer = setTimeout(() => list.classList.remove('is-scrolling'), 600);
        if (list.scrollTop + list.clientHeight >= list.scrollHeight - 60) loadMore();
    });

    loadMoreButton.hidden = currentPage >= totalPages;
    loadMoreButton.addEventListener('click', loadMore);

    // ===== 게시글 검색 (입력할 때마다 바로 조회, 엔터/버튼 불필요) =====
    async function runSearch(keyword) {
        currentKeyword = keyword;
        const query = new URLSearchParams({ page: 0, size: 10, sort: 'id,' + sortDirection });
        if (keyword) query.set('keyword', keyword);
        const res = await pageFetch('/api/boards?' + query.toString());
        if (!res.ok) return;
        const page = await res.json();
        const rows = page.content || [];
        list.innerHTML = rows.length ? rows.map(rowHtml).join('') : '<p class="empty">아직 등록된 게시글이 없습니다.</p>';
        list.scrollTop = 0;
        totalPages = page.totalPages;
        currentPage = 1;
        loadMoreButton.hidden = currentPage >= totalPages;
    }

    let searchTimer;
    keywordInput.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => runSearch(keywordInput.value.trim()), 200);
    });

    document.getElementById('search-form').addEventListener('submit', event => {
        event.preventDefault();
        clearTimeout(searchTimer);
        runSearch(keywordInput.value.trim());
    });

    document.getElementById('sort-toggle').addEventListener('click', event => {
        sortDirection = sortDirection === 'desc' ? 'asc' : 'desc';
        event.target.textContent = sortDirection === 'desc' ? '최신순' : '오래된순';
        runSearch(currentKeyword);
    });

    const modal = document.getElementById('create-modal');
    document.getElementById('open-create').addEventListener('click', () => {
        if (!requireLogin()) return;
        modal.hidden = false;
        loadItemsForSearch();
    });
    document.getElementById('close-create').addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', event => { if (event.target === modal) modal.hidden = true; });

    // ===== 관련 상품 검색/선택 (처음에는 100개만 불러오고, 글자를 입력하면 검색해서 찾기) =====
    let allItemsForSearch = [];
    let itemsLoaded = false;

    async function loadItemsForSearch() {
        if (itemsLoaded) return;
        const res = await pageFetch('/api/items?size=100');
        if (!res.ok) return;
        itemsLoaded = true;
        const page = await res.json();
        allItemsForSearch = page.content || [];
    }

    const itemSearchInput = document.getElementById('item-search');
    const itemSearchResults = document.getElementById('item-search-results');
    const boardItemIdInput = document.getElementById('board-item-id');

    // 모달의 overflow:auto에 드롭다운이 가려지지 않도록 body 바로 아래 fixed 위치로 띄움
    function positionDropdown() {
        const rect = itemSearchInput.getBoundingClientRect();
        itemSearchResults.style.position = 'fixed';
        itemSearchResults.style.top = rect.bottom + 'px';
        itemSearchResults.style.left = rect.left + 'px';
        itemSearchResults.style.width = rect.width + 'px';
    }

    // more: 처음 불러온 100개가 전부가 아닐 수 있다는 안내, pending: 서버 검색 결과를 기다리는 중
    function renderItemResults(matches, more = false, pending = false) {
        positionDropdown();
        itemSearchResults.innerHTML = matches.length
            ? matches.map(item => `<div class="autocomplete-item" data-id="${item.id}" data-title="${esc(item.title)}">${esc(item.title)}</div>`).join('')
              + (more ? '<div class="autocomplete-item empty">최대 100개까지 보여요. 검색어를 입력해 더 찾아보세요</div>' : '')
            : `<div class="autocomplete-item empty">${pending ? '검색 중...' : '검색 결과가 없습니다'}</div>`;
        itemSearchResults.querySelectorAll('[data-id]').forEach(el => el.addEventListener('click', () => {
            boardItemIdInput.value = el.dataset.id;
            itemSearchInput.value = el.dataset.title;
            itemSearchResults.innerHTML = '';
        }));
    }

    // 검색어가 없으면 처음 불러온 100개, 있으면 글자를 입력할 때마다 바로 서버에 검색 요청
    // (서버가 keyword 를 지원하면 전체에서 찾고, 아니면 받은 100개 안에서 걸러낸다)
    const ITEM_SEARCH_LIMIT = 100;
    let itemSearchSeq = 0;
    async function showItemResults() {
        const keyword = itemSearchInput.value.trim().toLowerCase();
        if (!keyword) {
            itemSearchSeq++;
            renderItemResults(allItemsForSearch, allItemsForSearch.length >= ITEM_SEARCH_LIMIT);
            return;
        }
        const seq = ++itemSearchSeq;
        // 이미 받아 둔 목록에서 먼저 바로 보여주고, 서버 검색 결과가 오면 교체
        renderItemResults(allItemsForSearch.filter(item => item.title.toLowerCase().includes(keyword)), false, true);
        const res = await pageFetch('/api/items?size=' + ITEM_SEARCH_LIMIT + '&keyword=' + encodeURIComponent(keyword));
        // 그 사이 더 새로운 글자가 입력됐다면 이 응답은 버린다 (늦게 도착한 이전 결과가 덮어쓰지 않게)
        if (!res.ok || seq !== itemSearchSeq) return;
        const found = ((await res.json()).content || []).filter(item => item.title.toLowerCase().includes(keyword));
        if (seq !== itemSearchSeq) return;
        renderItemResults(found);
    }

    itemSearchInput.addEventListener('focus', async () => {
        await loadItemsForSearch();
        showItemResults();
    });
    itemSearchInput.addEventListener('input', () => {
        boardItemIdInput.value = '';
        showItemResults();
    });
    document.addEventListener('click', event => {
        if (!itemSearchInput.contains(event.target) && !itemSearchResults.contains(event.target) && event.target !== itemSearchInput) {
            itemSearchResults.innerHTML = '';
        }
    });

    document.getElementById('create-form').addEventListener('submit', async event => {
        event.preventDefault();
        const message = document.getElementById('create-message');
        const itemIdValue = document.getElementById('board-item-id').value.trim();
        const body = {
            title: document.getElementById('board-title').value.trim(),
            content: document.getElementById('board-content').value.trim(),
            itemId: itemIdValue ? Number(itemIdValue) : null,
            isSecret: document.getElementById('board-secret').checked
        };
        const res = await pageFetch('/api/boards', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!res.ok) { message.textContent = await errorText(res, '등록에 실패했습니다.'); message.className = 'form-message error'; return; }
        const createdId = await res.json();
        location.href = '/test/board/' + createdId;
    });
})();
</script>

{{> fragments/footer}}
