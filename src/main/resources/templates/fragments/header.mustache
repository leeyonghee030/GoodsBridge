<script>
// 브라우저 기본 alert/confirm/prompt 를 사이트 디자인 대화상자로 대체한다.
// alert 는 await 하면 닫힐 때까지 기다릴 수 있고, 안 해도 기존처럼 동작한다.
(() => {
    function gbDialog({ message, confirm = false, prompt = false, defaultValue = '', html = null, multiline = false, maxLength = 500 }) {
        return new Promise(resolve => {
            const back = document.createElement('div');
            back.className = 'modal-backdrop gb-dialog-backdrop';
            back.innerHTML = '<div class="modal-card gb-dialog" role="dialog" aria-modal="true">'
                + '<p class="gb-dialog-msg"></p>'
                + (prompt ? (multiline
                    ? '<textarea class="gb-dialog-input" rows="5" maxlength="' + maxLength + '"></textarea><p class="gb-dialog-count"></p>'
                    : '<input type="text" class="gb-dialog-input">') : '')
                + '<div class="gb-dialog-actions">'
                + (confirm || prompt ? '<button type="button" class="gb-cancel">취소</button>' : '')
                + '<button type="button" class="gb-ok">확인</button></div></div>';
            // html 은 호출하는 쪽에서 이스케이프한 안내 조각만 넘긴다 (입찰 확인창 등)
            if (html) { const m = back.querySelector('.gb-dialog-msg'); m.classList.add('is-rich'); m.innerHTML = html; }
            else back.querySelector('.gb-dialog-msg').textContent = String(message ?? '');
            const input = back.querySelector('.gb-dialog-input');
            if (input) input.value = defaultValue;
            if (multiline && input) {
                // 길게 적는 입력: 넓은 창 + 글자 수 표시
                back.querySelector('.gb-dialog').classList.add('is-wide');
                const count = back.querySelector('.gb-dialog-count');
                const updateCount = () => { count.textContent = input.value.length + ' / ' + maxLength; };
                input.addEventListener('input', updateCount);
                updateCount();
            }
            const cancelValue = prompt ? null : (confirm ? false : undefined);
            const okValue = () => prompt ? input.value : (confirm ? true : undefined);

            function close(value) {
                document.removeEventListener('keydown', onKey, true);
                back.remove();
                resolve(value);
            }
            function onKey(e) {
                if (e.key === 'Escape') { e.preventDefault(); close(cancelValue); }
                // 여러 줄 입력에서는 Enter 가 줄바꿈이고, Ctrl+Enter 로 확인한다
                if (e.key === 'Enter' && multiline && prompt) {
                    if (e.ctrlKey || e.metaKey) { e.preventDefault(); close(okValue()); }
                    return;
                }
                if (e.key === 'Enter') { e.preventDefault(); close(okValue()); }
            }
            back.querySelector('.gb-ok').addEventListener('click', () => close(okValue()));
            const cancelBtn = back.querySelector('.gb-cancel');
            if (cancelBtn) cancelBtn.addEventListener('click', () => close(cancelValue));
            back.addEventListener('click', e => { if (e.target === back) close(cancelValue); });
            document.addEventListener('keydown', onKey, true);
            document.body.appendChild(back);
            (input || back.querySelector('.gb-ok')).focus();
        });
    }
    window.alert = message => gbDialog({ message });
    window.gbConfirm = (message, opts) => gbDialog({ message, confirm: true, html: opts && opts.html });
    window.gbPrompt = (message, defaultValue, opts) => gbDialog({ message, prompt: true, defaultValue, multiline: !!(opts && opts.multiline), maxLength: (opts && opts.maxLength) || 500 });
})();
</script>

<script>
    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }

    // ==================================================
    // 매장 선택 드롭다운
    // ==================================================
    (() => {
        const dropdown = document.getElementById('shop-dropdown');
        const trigger = document.getElementById('shop-trigger');
        const menu = document.getElementById('shop-menu');
        const list = document.getElementById('shop-menu-list');
        const search = document.getElementById('shop-menu-search');
        const KEY = 'gb_shop_id';

        if (!dropdown || !trigger || !menu || !list || !search) return;

        function selectShop(value, label) {
            trigger.textContent = label;

            list.querySelectorAll('li').forEach(li => {
                li.classList.toggle('active', li.dataset.value === value);
            });

            if (value) {
                localStorage.setItem(KEY, value);
            } else {
                localStorage.removeItem(KEY);
            }

            window.dispatchEvent(new CustomEvent('gb-shop-changed', {
                detail: value
            }));
        }

        const allShopItem = list.querySelector('[data-value=""]');

        if (allShopItem) {
            allShopItem.addEventListener('click', () => {
                selectShop('', '전체 매장');
                menu.hidden = true;
            });
        }

        fetch('/api/shops?size=100', { credentials: 'same-origin' })
            .then(res => res.ok ? res.json() : null)
            .then(page => {
                if (!page) return;

                const saved = localStorage.getItem(KEY) || '';

                (page.content || []).forEach(shop => {
                    const li = document.createElement('li');

                    li.dataset.value = String(shop.id);
                    li.dataset.name = shop.name.toLowerCase();
                    li.textContent = shop.name;

                    if (String(shop.id) === saved) {
                        li.classList.add('active');
                        trigger.textContent = shop.name;
                    }

                    li.addEventListener('click', () => {
                        selectShop(String(shop.id), shop.name);
                        menu.hidden = true;
                    });

                    list.appendChild(li);
                });
            })
            .catch(() => {});

        // 매장 검색
        search.addEventListener('input', () => {
            const keyword = search.value.trim().toLowerCase();

            list.querySelectorAll('li[data-name]').forEach(li => {
                li.hidden = keyword !== '' && !li.dataset.name.includes(keyword);
            });
        });

        // 드롭다운 열기/닫기
        trigger.addEventListener('click', () => {
            menu.hidden = !menu.hidden;

            if (!menu.hidden) {
                search.focus();
            }
        });

        // 외부 클릭 시 닫기
        document.addEventListener('click', event => {
            if (!dropdown.contains(event.target)) {
                menu.hidden = true;
            }
        });
    })();


    // ==================================================
    // 메가메뉴 인기 카테고리 / 이벤트 / 경매
    // ==================================================
    (() => {
        const esc = value =>
            String(value ?? '').replace(/[&<>'"]/g, char => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[char]));

        // 카테고리 랭킹 렌더링
        function renderCategoryRank(listEl, categories, buildHref) {
            if (!listEl || !categories || !categories.length) return;

            listEl.innerHTML = categories.map((category, index) =>
                `<li>
                <a href="${buildHref(category.name)}">
                    <span>${String(index + 1).padStart(2, '0')}</span>
                    ${esc(category.name)}
                </a>
            </li>`
            ).join('');
        }

        // 인기 구매 카테고리
        fetch('/api/categories/popular', { credentials: 'same-origin' })
            .then(res => res.ok ? res.json() : [])
            .then(categories => {
                renderCategoryRank(
                    document.getElementById('shop-category-rank-list'),
                    categories,
                    name => `/test/item?category=${encodeURIComponent(name)}`
                );
            })
            .catch(() => {});

        // 공통 JSON 요청
        const json = url =>
            fetch(url, { credentials: 'same-origin' })
                .then(res => res.ok ? res.json() : null)
                .catch(() => null);

        // 마감까지 남은 시간
        const leftLabel = deadline => {
            const ms = new Date(deadline) - new Date();
            const hours = Math.floor(ms / 3600000);

            if (hours < 1) {
                return `${Math.max(1, Math.floor(ms / 60000))}분 남음`;
            }

            if (hours < 24) {
                return `${hours}시간 남음`;
            }

            return `D-${Math.floor(hours / 24)}`;
        };

        // ----------------------------------------------
        // 이벤트 랭킹
        // 모집 중, 마감 전, 수량 남음
        // 내가 이미 최대 수량 구매한 이벤트 제외
        // 내 가게 이벤트 제외
        // 마감 빠른 순 최대 5개
        // ----------------------------------------------
        Promise.all([
            json('/api/events'),
            json('/api/events/me'),
            json('/api/shops/me')
        ])
            .then(([events, mine, myShops]) => {
                const now = new Date();

                // 내가 구매한 수량 집계
                const boughtQty = {};

                (mine || [])
                    .filter(p => p.status === 'JOINED')
                    .forEach(p => {
                        boughtQty[p.shopEventId] =
                            (boughtQty[p.shopEventId] || 0) + p.quantity;
                    });

                // 내 매장 ID
                const ownShops = new Set(
                    ((myShops && myShops.content) || []).map(shop => shop.id)
                );

                // 참가 가능한 이벤트 필터링
                const open = (events || [])
                    .filter(event =>
                        event.status === 'OPEN' &&
                        new Date(event.deadline) > now &&
                        event.currentCount < event.capacity
                    )
                    .filter(event =>
                        (boughtQty[event.id] || 0) < event.maxPerUser &&
                        !ownShops.has(event.shopId)
                    )
                    .sort((a, b) =>
                        new Date(a.deadline) - new Date(b.deadline)
                    )
                    .slice(0, 5);

                const listEl = document.getElementById('event-rank-list');

                if (!listEl || !open.length) return;

                listEl.innerHTML = open.map((event, index) =>
                    `<li>
                    <a href="/test/event/${event.id}" title="${esc(event.itemTitle)}">
                        <span>${String(index + 1).padStart(2, '0')}</span>
                        <em class="event-rank-title">${esc(event.itemTitle)}</em>
                        <small class="event-rank-left">${leftLabel(event.deadline)}</small>
                    </a>
                </li>`
                ).join('');

                // 대표 사진 링크를 가장 임박한 이벤트로 연결
                const photo = document.getElementById('event-rank-photo');

                if (photo) {
                    photo.href = `/test/event/${open[0].id}`;

                    const label = photo.querySelector('strong + span');
                    if (label) {
                        label.textContent = '마감 임박 · 자세히 보기';
                    }
                }
            })
            .catch(() => {});

        // ----------------------------------------------
        // 경매 랭킹
        // 진행 중인 경매 중 내 가게 경매 제외
        // 마감 빠른 순 최대 5개
        // ----------------------------------------------
        Promise.all([
            json('/api/auctions?page=1&size=50&status=ACTIVE'),
            json('/api/shops/me')
        ])
            .then(([page, myShops]) => {
                const now = new Date();

                const ownShops = new Set(
                    ((myShops && myShops.content) || []).map(shop => shop.id)
                );

                const live = ((page && page.content) || [])
                    .filter(auction =>
                        new Date(auction.deadline) > now &&
                        !ownShops.has(auction.shopId)
                    )
                    .sort((a, b) =>
                        new Date(a.deadline) - new Date(b.deadline)
                    )
                    .slice(0, 5);

                const listEl = document.getElementById('auction-rank-list');

                if (!listEl || !live.length) return;

                listEl.innerHTML = live.map((auction, index) =>
                    `<li>
                    <a href="/test/auction/${auction.id}" title="${esc(auction.itemTitle)}">
                        <span>${String(index + 1).padStart(2, '0')}</span>
                        <em class="event-rank-title">${esc(auction.itemTitle)}</em>
                        <small class="event-rank-left">${leftLabel(auction.deadline)}</small>
                    </a>
                </li>`
                ).join('');

                // 대표 경매 사진
                const photo = document.getElementById('auction-rank-photo');

                if (photo) {
                    photo.href = `/test/auction/${live[0].id}`;

                    if (live[0].itemImageUrl) {
                        const img = photo.querySelector('img');
                        if (img) img.src = live[0].itemImageUrl;
                    }

                    const label = photo.querySelector('strong + span');
                    if (label) {
                        label.textContent = '마감 임박 · 자세히 보기';
                    }
                }
            })
            .catch(() => {});

        // 인기 교환 카테고리
        fetch('/api/categories/popular-exchange', { credentials: 'same-origin' })
            .then(res => res.ok ? res.json() : [])
            .then(categories => {
                renderCategoryRank(
                    document.getElementById('exchange-category-rank-list'),
                    categories,
                    name => `/exchange?categoryName=${encodeURIComponent(name)}`
                );
            })
            .catch(() => {});
    })();


    // ==================================================
    // 홈 내비게이션 축소
    // ==================================================
    document.addEventListener('DOMContentLoaded', () => {
        const nav = document.querySelector('.nav');

        if (!nav || !nav.classList.contains('hero')) return;

        function shrinkNav() {
            nav.classList.remove('hero');

            const main = document.querySelector('main');
            if (main) {
                main.style.paddingTop = '0';
            }
        }

        window.addEventListener('scroll', () => {
            if (window.scrollY > 5) {
                shrinkNav();
            }
        });

        window.addEventListener('mousemove', shrinkNav, { once: true });
    });


    // ==================================================
    // 로그인 / 회원가입
    // ==================================================
    (() => {
        const loginTrigger = document.getElementById('nav-login');

        if (!loginTrigger) return;

        const modal = document.getElementById('login-modal');
        const form = document.getElementById('login-modal-form');
        const message = document.getElementById('login-modal-message');

        if (!modal || !form || !message) return;

        // 로그인 모달 열기
        loginTrigger.addEventListener('click', () => {
            modal.hidden = false;
        });

        // login=open 쿼리로 진입한 경우 모달 자동 열기
        if (new URLSearchParams(location.search).get('login') === 'open') {
            modal.hidden = false;
            history.replaceState(null, '', location.pathname);
        }

        {{#loginError}}
            // 로그인 실패 처리
            (async () => {
                await alert(document.getElementById('login-error').dataset.message);

                {{#kakaoRetry}}
                    location.href = '/api/kakao-login?reselect=true';
                {{/kakaoRetry}}

                {{^kakaoRetry}}
                    modal.hidden = false;
                {{/kakaoRetry}}
            })();
        {{/loginError}}

        // 로그인 모달 닫기
        const loginClose = document.getElementById('login-modal-close');

        if (loginClose) {
            loginClose.addEventListener('click', () => {
                modal.hidden = true;
            });
        }

        modal.addEventListener('click', event => {
            if (event.target === modal) {
                modal.hidden = true;
            }
        });

        // 로그인 요청
        form.addEventListener('submit', async event => {
            event.preventDefault();

            message.textContent = '';
            message.className = 'form-message';

            try {
                const response = await fetch('/api/login', {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: new URLSearchParams(new FormData(form))
                });

                if (!response.ok) {
                    const error = await response.json().catch(() => null);

                    await alert(
                        (error && error.message) ||
                        '이메일 또는 비밀번호를 확인해주세요.'
                    );
                    return;
                }

                location.reload();

            } catch (e) {
                message.textContent = '로그인 중 오류가 발생했습니다.';
                message.className = 'form-message error';
            }
        });


        // ----------------------------------------------
        // 회원가입
        // ----------------------------------------------
        const openSignup = document.getElementById('open-signup');

        if (!openSignup) return;

        const signupModal = document.getElementById('signup-modal');
        const signupForm = document.getElementById('signup-modal-form');

        if (!signupModal || !signupForm) return;

        const signupMessage = document.getElementById('signup-modal-message');
        const verifyMessage = document.getElementById('signup-verify-msg');

        const emailInput = document.getElementById('signup-email');
        const emailIdInput = document.getElementById('signup-email-id');
        const emailDomainInput = document.getElementById('signup-email-domain');

        const codeBox = document.getElementById('signup-code-box');
        const codeInput = document.getElementById('signup-code');

        const sendBtn = document.getElementById('signup-send-btn');
        const verifyBtn = document.getElementById('signup-verify-btn');
        const submitBtn = document.getElementById('signup-submit-btn');

        const passwordInput = document.getElementById('signup-password');
        const passwordConfirmInput = document.getElementById('signup-password-confirm');
        const passwordMatchMsg = document.getElementById('signup-password-match-msg');

        let isEmailVerified = false;

        // 이메일 조합
        function updateEmailValue() {
            const emailId = emailIdInput.value.trim();
            const domain = emailDomainInput.value.trim();

            emailInput.value = emailId && domain
                ? `${emailId}@${domain}`
                : '';
        }

        emailIdInput.addEventListener('input', updateEmailValue);
        emailDomainInput.addEventListener('input', updateEmailValue);
        updateEmailValue();


        // 비밀번호 일치 여부
        function checkPasswordMatch() {
            if (!passwordConfirmInput.value) {
                passwordMatchMsg.textContent = '';
                passwordMatchMsg.className = 'form-message';
                return;
            }

            if (passwordInput.value === passwordConfirmInput.value) {
                passwordMatchMsg.textContent = '비밀번호가 일치합니다.';
                passwordMatchMsg.className = 'form-message';
            } else {
                passwordMatchMsg.textContent = '비밀번호가 일치하지 않습니다.';
                passwordMatchMsg.className = 'form-message error';
            }
        }

        passwordInput.addEventListener('input', checkPasswordMatch);
        passwordConfirmInput.addEventListener('input', checkPasswordMatch);


        // 회원가입 폼 초기화
        function resetSignupForm() {
            signupForm.reset();

            isEmailVerified = false;

            codeBox.hidden = true;
            codeInput.value = '';
            codeInput.disabled = false;

            verifyMessage.textContent = '';
            verifyMessage.className = 'form-message';

            signupMessage.textContent = '';
            signupMessage.className = 'form-message';

            passwordMatchMsg.textContent = '';
            passwordMatchMsg.className = 'form-message';

            emailIdInput.disabled = false;
            emailDomainInput.disabled = false;

            sendBtn.disabled = false;
            sendBtn.textContent = '인증번호 전송';

            verifyBtn.disabled = false;
            submitBtn.disabled = false;
        }


        // 회원가입 모달 열기
        openSignup.addEventListener('click', () => {
            modal.hidden = true;
            resetSignupForm();
            signupModal.hidden = false;
        });

        // 회원가입 모달 닫기
        const signupClose = document.getElementById('signup-modal-close');

        if (signupClose) {
            signupClose.addEventListener('click', () => {
                signupModal.hidden = true;
            });
        }

        signupModal.addEventListener('click', event => {
            if (event.target === signupModal) {
                signupModal.hidden = true;
            }
        });


        // ----------------------------------------------
        // 회원가입 이메일 인증번호 전송
        // ----------------------------------------------
        sendBtn.addEventListener('click', async () => {
            if (sendBtn.disabled) return;

            updateEmailValue();

            const email = emailInput.value.trim();

            if (!email) {
                verifyMessage.textContent = '이메일을 입력해주세요.';
                verifyMessage.className = 'form-message error';
                return;
            }

            sendBtn.disabled = true;
            sendBtn.textContent = '전송 중...';

            try {
                const response = await fetch('/api/email/send', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email })
                });

                const result = await response.json().catch(() => ({}));

                if (!response.ok) {
                    verifyMessage.textContent =
                        result.message || '인증번호 전송에 실패했습니다.';
                    verifyMessage.className = 'form-message error';
                    return;
                }

                codeBox.hidden = false;

                codeInput.value = '';
                codeInput.disabled = false;
                verifyBtn.disabled = false;

                verifyMessage.textContent = '인증번호를 보냈습니다.';
                verifyMessage.className = 'form-message';

                codeInput.focus();

            } catch (e) {
                verifyMessage.textContent = '서버와 통신하지 못했습니다.';
                verifyMessage.className = 'form-message error';

            } finally {
                sendBtn.disabled = false;
                sendBtn.textContent = '인증번호 전송';
            }
        });


        // ----------------------------------------------
        // 회원가입 이메일 인증 확인 (단일 입력)
        // ----------------------------------------------
        verifyBtn.addEventListener('click', async () => {
            if (verifyBtn.disabled) return;

            const email = emailInput.value.trim();
            const code = codeInput.value.trim();

            if (!/^\d{6}$/.test(code)) {
                verifyMessage.textContent = '인증번호 6자리를 입력해주세요.';
                verifyMessage.className = 'form-message error';
                codeInput.focus();
                return;
            }

            verifyBtn.disabled = true;

            try {
                const response = await fetch('/api/email/verify', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email, code })
                });

                const result = await response.json().catch(() => ({}));

                if (response.ok) {
                    isEmailVerified = true;

                    verifyMessage.textContent = result.message || '인증되었습니다.';
                    verifyMessage.className = 'form-message';

                    emailIdInput.disabled = true;
                    emailDomainInput.disabled = true;
                    sendBtn.disabled = true;
                    codeInput.disabled = true;
                    verifyBtn.disabled = true;

                } else {
                    verifyMessage.textContent =
                        result.message || '인증번호가 일치하지 않습니다.';
                    verifyMessage.className = 'form-message error';

                    if (response.status === 429) {
                        isEmailVerified = false;
                        codeBox.hidden = true;
                        codeInput.value = '';

                        emailIdInput.disabled = false;
                        emailDomainInput.disabled = false;
                        sendBtn.disabled = false;
                    }
                }

            } catch (e) {
                verifyMessage.textContent = '서버와 통신하지 못했습니다.';
                verifyMessage.className = 'form-message error';

            } finally {
                verifyBtn.disabled = isEmailVerified;
            }
        });


        // ----------------------------------------------
        // 회원가입 제출
        // ----------------------------------------------
        signupForm.addEventListener('submit', async event => {
            event.preventDefault();

            if (submitBtn.disabled) return;

            signupMessage.textContent = '';
            signupMessage.className = 'form-message';

            if (!isEmailVerified) {
                signupMessage.textContent = '이메일 인증을 먼저 해주세요.';
                signupMessage.className = 'form-message error';
                return;
            }

            const password = passwordInput.value;
            const passwordConfirm = passwordConfirmInput.value;

            if (password !== passwordConfirm) {
                signupMessage.textContent = '비밀번호가 일치하지 않습니다.';
                signupMessage.className = 'form-message error';
                return;
            }

            submitBtn.disabled = true;

            try {
                const response = await fetch('/api/join', {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: new URLSearchParams(new FormData(signupForm))
                });

                if (!response.ok) {
                    const error = await response.json().catch(() => null);

                    signupMessage.textContent =
                        (error && error.message) || '회원가입에 실패했습니다.';
                    signupMessage.className = 'form-message error';
                    return;
                }

                const verifiedEmail = emailInput.value.trim();

                signupModal.hidden = true;
                resetSignupForm();

                document.getElementById('login-email').value = verifiedEmail;
                modal.hidden = false;

            } catch (e) {
                signupMessage.textContent = '회원가입 중 오류가 발생했습니다.';
                signupMessage.className = 'form-message error';

            } finally {
                submitBtn.disabled = false;
            }
        });
    })();


    // ==================================================
    // 계정 부활 인증번호 6칸 입력 UI
    // 회원가입 인증과 별개로 동작
    // ==================================================
    (() => {
        const restoreCodeBox = document.getElementById('restore-code-box');

        if (!restoreCodeBox) return;

        const digits = restoreCodeBox.querySelectorAll('.verify-digit');
        const restoreVerifyBtn = document.getElementById('restore-verify-btn');

        if (!restoreVerifyBtn || digits.length !== 6) return;

        // 6칸의 인증번호를 하나의 문자열로 반환
        function getRestoreCode() {
            return Array.from(digits)
                .map(input => input.value)
                .join('');
        }

        // 여러 숫자 입력 및 붙여넣기 처리
        function fillCode(code) {
            const numbers = code.replace(/\D/g, '').slice(0, 6);

            digits.forEach((input, index) => {
                input.value = numbers[index] || '';
            });

            // 미완성 시 다음 빈 칸, 완성 시 마지막 칸
            const focusIndex = Math.min(numbers.length, digits.length - 1);
            digits[focusIndex]?.focus();
        }

        // 각 칸 입력事件
        digits.forEach((input, index) => {

            // 숫자 입력
            input.addEventListener('input', () => {
                const value = input.value.replace(/\D/g, '');

                // 자동완성 등 여러 글자가 들어온 경우
                if (value.length > 1) {
                    fillCode(value);
                    return;
                }

                input.value = value.slice(0, 1);

                // 다음 칸으로 이동
                if (input.value && digits[index + 1]) {
                    digits[index + 1].focus();
                }
            });

            // 키보드 이동
            input.addEventListener('keydown', event => {
                if (event.key === 'Backspace' && !input.value) {
                    digits[index - 1]?.focus();
                }

                if (event.key === 'ArrowLeft') {
                    digits[index - 1]?.focus();
                }

                if (event.key === 'ArrowRight') {
                    digits[index + 1]?.focus();
                }
            });

            // 붙여넣기
            input.addEventListener('paste', event => {
                event.preventDefault();

                const pastedCode = event.clipboardData
                    .getData('text')
                    .replace(/\D/g, '')
                    .slice(0, 6);

                if (pastedCode) {
                    fillCode(pastedCode);
                }
            });
        });

        // 계정 부활 인증 확인
        restoreVerifyBtn.addEventListener('click', async () => {
            const code = getRestoreCode();

            if (!/^\d{6}$/.test(code)) {
                alert('인증번호 6자리를 입력해주세요.');

                const firstEmpty = Array.from(digits)
                    .find(input => !input.value);

                (firstEmpty || digits[0]).focus();
                return;
            }

            console.log('계정 부활 인증번호:', code);

            // TODO:
            // 계정 부활 인증 API 연결
        });
    })();


    // ==================================================
    // 메가 메뉴
    // ==================================================
    (() => {
        const nav = document.querySelector('.nav');
        const backdrop = document.querySelector('.nav-backdrop');
        const items = document.querySelectorAll('.nav-item-mega');

        if (!nav || !backdrop || !items.length) return;

        let activeItem = null;

        function closeMega() {
            if (activeItem) {
                activeItem.classList.remove('open');
            }

            activeItem = null;
            backdrop.classList.remove('show');
        }

        // 메가 메뉴 열기
        items.forEach(item => {
            item.addEventListener('mouseenter', () => {
                if (activeItem && activeItem !== item) {
                    activeItem.classList.remove('open');
                }

                item.classList.add('open');
                activeItem = item;
                backdrop.classList.add('show');
            });
        });

        // 메가 메뉴가 아닌 메뉴에 마우스 이동 시 닫기
        Array.from(nav.children).forEach(child => {
            if (!child.classList.contains('nav-item-mega')) {
                child.addEventListener('mouseenter', closeMega);
            }
        });

        nav.addEventListener('mouseleave', closeMega);
    })();
</script>
<main>
