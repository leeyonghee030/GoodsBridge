<script>
// 브라우저 기본 alert/confirm/prompt 를 사이트 디자인 대화상자로 대체한다.
// alert 는 await 하면 닫힐 때까지 기다릴 수 있고, 안 해도 기존처럼 동작한다.
(() => {
    function gbDialog({ message, confirm = false, prompt = false, defaultValue = '' }) {
        return new Promise(resolve => {
            const back = document.createElement('div');
            back.className = 'modal-backdrop gb-dialog-backdrop';
            back.innerHTML = '<div class="modal-card gb-dialog" role="dialog" aria-modal="true">'
                + '<p class="gb-dialog-msg"></p>'
                + (prompt ? '<input type="text" class="gb-dialog-input">' : '')
                + '<div class="gb-dialog-actions">'
                + (confirm || prompt ? '<button type="button" class="gb-cancel">취소</button>' : '')
                + '<button type="button" class="gb-ok">확인</button></div></div>';
            back.querySelector('.gb-dialog-msg').textContent = String(message ?? '');
            const input = back.querySelector('.gb-dialog-input');
            if (input) input.value = defaultValue;
            const cancelValue = prompt ? null : (confirm ? false : undefined);
            const okValue = () => prompt ? input.value : (confirm ? true : undefined);

            function close(value) {
                document.removeEventListener('keydown', onKey, true);
                back.remove();
                resolve(value);
            }
            function onKey(e) {
                if (e.key === 'Escape') { e.preventDefault(); close(cancelValue); }
                if (e.key === 'Enter') { e.preventDefault(); close(okValue()); }
            }
            back.querySelector('.gb-ok').addEventListener('click', () => close(okValue()));
            const cancelBtn = back.querySelector('.gb-cancel');
            if (cancelBtn) cancelBtn.addEventListener('click', () => close(cancelValue));
            back.addEventListener('click', e => { if (e.target === back) close(cancelValue); });
            document.addEventListener('keydown', onKey, true);
            document.body.appendChild(back);
            (input || back.querySelector('.gb-ok')).focus();
        });
    }
    window.alert = message => gbDialog({ message });
    window.gbConfirm = message => gbDialog({ message, confirm: true });
    window.gbPrompt = (message, defaultValue) => gbDialog({ message, prompt: true, defaultValue });
})();
</script>

<script>
if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }

(() => {
    const dropdown = document.getElementById('shop-dropdown');
    const trigger = document.getElementById('shop-trigger');
    const menu = document.getElementById('shop-menu');
    const list = document.getElementById('shop-menu-list');
    const search = document.getElementById('shop-menu-search');
    const KEY = 'gb_shop_id';

    function selectShop(value, label) {
        trigger.textContent = label;
        list.querySelectorAll('li').forEach(li => li.classList.toggle('active', li.dataset.value === value));
        if (value) localStorage.setItem(KEY, value);
        else localStorage.removeItem(KEY);
        window.dispatchEvent(new CustomEvent('gb-shop-changed', { detail: value }));
    }

    list.querySelector('[data-value=""]').addEventListener('click', () => { selectShop('', '전체 매장'); menu.hidden = true; });

    fetch('/api/shops?size=100', { credentials: 'same-origin' })
        .then(res => res.ok ? res.json() : null)
        .then(page => {
            if (!page) return;
            const saved = localStorage.getItem(KEY) || '';
            (page.content || []).forEach(shop => {
                const li = document.createElement('li');
                li.dataset.value = String(shop.id);
                li.dataset.name = shop.name.toLowerCase();
                li.textContent = shop.name;
                if (String(shop.id) === saved) {
                    li.classList.add('active');
                    trigger.textContent = shop.name;
                }
                li.addEventListener('click', () => { selectShop(String(shop.id), shop.name); menu.hidden = true; });
                list.appendChild(li);
            });
        });

    // 매장이 많을 때(100개 등) 검색으로 좁혀 찾을 수 있게
    search.addEventListener('input', () => {
        const keyword = search.value.trim().toLowerCase();
        list.querySelectorAll('li[data-name]').forEach(li => {
            li.hidden = keyword !== '' && !li.dataset.name.includes(keyword);
        });
    });

    trigger.addEventListener('click', () => { menu.hidden = !menu.hidden; if (!menu.hidden) search.focus(); });
    document.addEventListener('click', event => { if (!dropdown.contains(event.target)) menu.hidden = true; });
})();

// 메가메뉴 인기 카테고리 (구매/교환 건수 기준 랭킹, 데이터 없으면 위 하드코딩된 기본 목록 유지)
(() => {
    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));

    function renderCategoryRank(listEl, categories, buildHref) {
        if (!listEl || !categories.length) return;
        listEl.innerHTML = categories.map((c, i) =>
            `<li><a href="${buildHref(c.name)}"><span>${String(i + 1).padStart(2, '0')}</span>${esc(c.name)}</a></li>`
        ).join('');
    }

    fetch('/api/categories/popular', { credentials: 'same-origin' })
        .then(res => res.ok ? res.json() : [])
        .then(categories => renderCategoryRank(
            document.getElementById('shop-category-rank-list'),
            categories,
            name => `/test/item?category=${encodeURIComponent(name)}`
        ))
        .catch(() => {});

    fetch('/api/categories/popular-exchange', { credentials: 'same-origin' })
        .then(res => res.ok ? res.json() : [])
        .then(categories => renderCategoryRank(
            document.getElementById('exchange-category-rank-list'),
            categories,
            name => `/exchange?categoryName=${encodeURIComponent(name)}`
        ))
        .catch(() => {});
})();

document.addEventListener('DOMContentLoaded', () => {
    // .hero 클래스는 서버(홈 컨트롤러)에서만 렌더링해서 붙여준다 — 홈이 아닌 페이지는
    // 애초에 이 클래스 자체가 없으므로 JS 타이밍과 무관하게 항상 기본(작은 배지) 상태로 시작한다.
    // 홈 화면만 스크롤/조작 시 .hero를 제거해 같은 배지 상태로 줄어든다.
    const nav = document.querySelector('.nav');
    if (!nav.classList.contains('hero')) return;

    function shrinkNav() {
        nav.classList.remove('hero');
        document.querySelector('main').style.paddingTop = '0';
    }
    window.addEventListener('scroll', () => { if (window.scrollY > 5) shrinkNav(); });
    window.addEventListener('mousemove', shrinkNav, { once: true });
});

(() => {
    const loginTrigger = document.getElementById('nav-login');
    if (!loginTrigger) return;

    const modal = document.getElementById('login-modal');
    const form = document.getElementById('login-modal-form');
    const message = document.getElementById('login-modal-message');

    loginTrigger.addEventListener('click', () => { modal.hidden = false; });
    document.getElementById('login-modal-close').addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', event => { if (event.target === modal) modal.hidden = true; });

    form.addEventListener('submit', async event => {
        event.preventDefault();
        message.textContent = '';
        message.className = 'form-message';
        try {
            const response = await fetch('/api/login', {
                method: 'POST',
                credentials: 'same-origin',
                body: new URLSearchParams(new FormData(form))
            });
            if (!response.ok) {
                const error = await response.json().catch(() => null);
                message.textContent = (error && error.message) || '이메일 또는 비밀번호를 확인해주세요.';
                message.className = 'form-message error';
                return;
            }
            location.reload();
        } catch (e) {
            message.textContent = '로그인 중 오류가 발생했습니다.';
            message.className = 'form-message error';
        }
    });

    const openSignup = document.getElementById('open-signup');
    if (openSignup) {
        const signupModal = document.getElementById('signup-modal');
        const signupForm = document.getElementById('signup-modal-form');
        const signupMessage = document.getElementById('signup-modal-message');
        const verifyMessage = document.getElementById('signup-verify-msg');
        const emailInput = document.getElementById('signup-email');
        const emailIdInput = document.getElementById('signup-email-id');
        const emailDomainInput = document.getElementById('signup-email-domain');
        const codeBox = document.getElementById('signup-code-box');
        const sendBtn = document.getElementById('signup-send-btn');
        const verifyBtn = document.getElementById('signup-verify-btn');
        const submitBtn = document.getElementById('signup-submit-btn');
        const passwordInput = document.getElementById('signup-password');
        const passwordConfirmInput = document.getElementById('signup-password-confirm');
        const passwordMatchMsg = document.getElementById('signup-password-match-msg');
        let isEmailVerified = false;

        function updateEmailValue() {
            const domain = emailDomainInput.value.trim();
            emailInput.value = emailIdInput.value.trim() && domain ? `${emailIdInput.value.trim()}@${domain}` : '';
        }
        emailIdInput.addEventListener('input', updateEmailValue);
        emailDomainInput.addEventListener('input', updateEmailValue);
        updateEmailValue();

        function checkPasswordMatch() {
            if (!passwordConfirmInput.value) { passwordMatchMsg.textContent = ''; return; }
            if (passwordInput.value === passwordConfirmInput.value) {
                passwordMatchMsg.textContent = '비밀번호가 일치합니다.';
                passwordMatchMsg.className = 'form-message';
            } else {
                passwordMatchMsg.textContent = '비밀번호가 일치하지 않습니다.';
                passwordMatchMsg.className = 'form-message error';
            }
        }
        passwordInput.addEventListener('input', checkPasswordMatch);
        passwordConfirmInput.addEventListener('input', checkPasswordMatch);

        function resetSignupForm() {
            signupForm.reset();
            isEmailVerified = false;
            codeBox.hidden = true;
            verifyMessage.textContent = '';
            verifyMessage.className = 'form-message';
            signupMessage.textContent = '';
            signupMessage.className = 'form-message';
            passwordMatchMsg.textContent = '';
            passwordMatchMsg.className = 'form-message';
            emailIdInput.disabled = false;
            emailDomainInput.disabled = false;
            sendBtn.disabled = false;
            sendBtn.textContent = '인증번호 전송';
            verifyBtn.disabled = false;
            submitBtn.disabled = false;
        }

        openSignup.addEventListener('click', () => { modal.hidden = true; resetSignupForm(); signupModal.hidden = false; });
        document.getElementById('signup-modal-close').addEventListener('click', () => { signupModal.hidden = true; });
        signupModal.addEventListener('click', event => { if (event.target === signupModal) signupModal.hidden = true; });

        sendBtn.addEventListener('click', async () => {
            if (sendBtn.disabled) return;
            updateEmailValue();
            const email = emailInput.value.trim();
            if (!email) { verifyMessage.textContent = '이메일을 입력해주세요.'; verifyMessage.className = 'form-message error'; return; }
            sendBtn.disabled = true;
            sendBtn.textContent = '전송 중...';
            try {
                const response = await fetch('/api/email/send', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) { verifyMessage.textContent = result.message || '인증번호 전송에 실패했습니다.'; verifyMessage.className = 'form-message error'; return; }
                codeBox.hidden = false;
                verifyMessage.textContent = '인증번호를 보냈습니다.';
                verifyMessage.className = 'form-message';
            } catch (e) {
                verifyMessage.textContent = '서버와 통신하지 못했습니다.';
                verifyMessage.className = 'form-message error';
            } finally {
                sendBtn.disabled = false;
                sendBtn.textContent = '인증번호 전송';
            }
        });

        verifyBtn.addEventListener('click', async () => {
            if (verifyBtn.disabled) return;
            const email = emailInput.value.trim();
            const code = document.getElementById('signup-code').value.trim();
            if (!code) { verifyMessage.textContent = '인증번호를 입력해주세요.'; verifyMessage.className = 'form-message error'; return; }
            verifyBtn.disabled = true;
            try {
                const response = await fetch('/api/email/verify', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, code })
                });
                const result = await response.json().catch(() => ({}));
                if (response.ok) {
                    isEmailVerified = true;
                    verifyMessage.textContent = result.message || '인증되었습니다.';
                    verifyMessage.className = 'form-message';
                    emailIdInput.disabled = true;
                    emailDomainInput.disabled = true;
                    sendBtn.disabled = true;
                } else {
                    verifyMessage.textContent = result.message || '인증번호가 일치하지 않습니다.';
                    verifyMessage.className = 'form-message error';
                    if (response.status === 429) {
                        isEmailVerified = false;
                        codeBox.hidden = true;
                        document.getElementById('signup-code').value = '';
                        emailIdInput.disabled = false;
                        emailDomainInput.disabled = false;
                        sendBtn.disabled = false;
                    }
                }
            } catch (e) {
                verifyMessage.textContent = '서버와 통신하지 못했습니다.';
                verifyMessage.className = 'form-message error';
            } finally {
                verifyBtn.disabled = false;
            }
        });

        signupForm.addEventListener('submit', async event => {
            event.preventDefault();
            if (submitBtn.disabled) return;
            signupMessage.textContent = '';
            signupMessage.className = 'form-message';
            if (!isEmailVerified) { signupMessage.textContent = '이메일 인증을 먼저 해주세요.'; signupMessage.className = 'form-message error'; return; }
            const password = document.getElementById('signup-password').value;
            const passwordConfirm = document.getElementById('signup-password-confirm').value;
            if (password !== passwordConfirm) { signupMessage.textContent = '비밀번호가 일치하지 않습니다.'; signupMessage.className = 'form-message error'; return; }
            submitBtn.disabled = true;
            try {
                const response = await fetch('/api/join', {
                    method: 'POST', credentials: 'same-origin',
                    body: new URLSearchParams(new FormData(signupForm))
                });
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    signupMessage.textContent = (error && error.message) || '회원가입에 실패했습니다.';
                    signupMessage.className = 'form-message error';
                    return;
                }
                const verifiedEmail = emailInput.value.trim();
                signupModal.hidden = true;
                resetSignupForm();
                document.getElementById('login-email').value = verifiedEmail;
                modal.hidden = false;
            } catch (e) {
                signupMessage.textContent = '회원가입 중 오류가 발생했습니다.';
                signupMessage.className = 'form-message error';
            } finally {
                submitBtn.disabled = false;
            }
        });
    }
})();

(() => {
    const nav = document.querySelector('.nav');
    const backdrop = document.querySelector('.nav-backdrop');
    const items = document.querySelectorAll('.nav-item-mega');
    let activeItem = null;

    function closeMega() {
        if (activeItem) activeItem.classList.remove('open');
        activeItem = null;
        backdrop.classList.remove('show');
    }

    items.forEach(item => {
        item.addEventListener('mouseenter', () => {
            if (activeItem && activeItem !== item) activeItem.classList.remove('open');
            item.classList.add('open');
            activeItem = item;
            backdrop.classList.add('show');
        });
    });

    Array.from(nav.children).forEach(child => {
        if (!child.classList.contains('nav-item-mega')) {
            child.addEventListener('mouseenter', closeMega);
        }
    });

    nav.addEventListener('mouseleave', closeMega);
})();
</script>
