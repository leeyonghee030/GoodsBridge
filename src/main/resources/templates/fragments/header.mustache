<!doctype html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>GoodsBridge</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
    <nav class="nav">
        <!-- 실제 화면 나오기 전까지는 /test/* 로 임시 연결. 화면 교체 시 함께 수정 -->
        <a href="/test/item">상품</a>
        <a href="/test/exchange">교환</a>
        <a href="/test/board">게시판</a>
        <a href="/test/user" id="nav-login">로그인</a>
    </nav>
    <div class="notification-area">
        <button class="notification-trigger" id="notification-trigger" type="button"
                aria-label="알림 열기" aria-expanded="false" aria-controls="notification-panel">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></svg>
            <span class="notification-badge" id="notification-badge" hidden></span>
        </button>
        <section class="notification-panel" id="notification-panel" aria-label="알림센터" hidden>
            <div class="notification-panel-heading">
                <h2>알림</h2>
                <button class="notification-close" id="notification-close" type="button" aria-label="알림 닫기">×</button>
            </div>
            <div class="notification-panel-subheading">
                <span>새로운 소식</span>
                <span class="notification-unread-label" id="notification-unread-label"></span>
            </div>
            <div class="notification-list" id="notification-list" aria-live="polite">
                <p class="notification-state">알림을 불러오는 중입니다.</p>
            </div>
        </section>
    </div>
</header>
<main class="container">
