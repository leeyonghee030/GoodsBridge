    <script>
        // 6칸 인증 UI - 기존 이메일 인증 로직에 연결
        const codeDigits = signupModal.querySelectorAll('.verify-digit');
        const originalCodeInput = document.getElementById('signup-code');

        function syncCodeInput() {
            originalCodeInput.value = Array.from(codeDigits)
                .map(input => input.value)
                .join('');
        }

        function fillCode(code) {
            const numbers = code.replace(/\D/g, '').slice(0, 6);

            codeDigits.forEach((input, index) => {
                input.value = numbers[index] || '';
            });

            syncCodeInput();

            // 마지막 입력 칸 또는 첫 빈 칸으로 포커스
            const nextIndex = Math.min(numbers.length, 5);
            codeDigits[nextIndex].focus();

            // 6자리 완성 시 기존 인증 버튼 실행
            if (numbers.length === 6) {
                originalCodeInput.value = numbers;
                verifyBtn.click();
            }
        }

        codeDigits.forEach((input, index) => {

            // 한 자리 입력 시 다음 칸 이동
            input.addEventListener('input', () => {
                const value = input.value.replace(/\D/g, '');

                // 모바일 자동완성 또는 여러 글자 입력 대응
                if (value.length > 1) {
                    fillCode(value);
                    return;
                }

                input.value = value.slice(0, 1);
                syncCodeInput();

                if (input.value && codeDigits[index + 1]) {
                    codeDigits[index + 1].focus();
                }

                // 6자리 입력 시 기존 인증 로직 자동 실행
                if (originalCodeInput.value.length === 6) {
                    verifyBtn.click();
                }
            });

            // Backspace 시 이전 칸 이동
            input.addEventListener('keydown', event => {
                if (event.key === 'Backspace' && !input.value) {
                    codeDigits[index - 1]?.focus();
                }

                if (event.key === 'ArrowLeft') {
                    codeDigits[index - 1]?.focus();
                }

                if (event.key === 'ArrowRight') {
                    codeDigits[index + 1]?.focus();
                }
            });

            // 붙여넣기 시 6칸 채우기
            input.addEventListener('paste', event => {
                event.preventDefault();

                const pastedCode = event.clipboardData
                    .getData('text')
                    .replace(/\D/g, '')
                    .slice(0, 6);

                if (pastedCode) {
                    fillCode(pastedCode);
                }
            });
        });
    </script>

<script>
// 가게 사장님이면 내 정보 화면의 탭이 '가게 교환 관리 / 판매 상품 관리'로 바뀐다 (가게 계정에는 개인 교환/구매 내역이 없다)
fetch('/api/shops/me', { credentials: 'same-origin' })
    .then(r => r.ok ? r.json() : null)
    .then(d => {
        if (!(d && d.content && d.content.length)) return;
        // 가게 사장님의 MY PAGE는 대시보드로 간다 (내 정보는 대시보드 옆 탭에 있다)
        const myPage = document.getElementById('nav-mypage');
        if (myPage) myPage.href = '/shop/dashboard';
        // 가게는 체인점 성격이라 개인 구매 내역 탭을 두지 않는다
        document.querySelectorAll('.my-tabs a[href="/my/purchases"], .my-tabs a[href="/my/events"], .my-tabs a[href="/my/auctions"], .my-tabs a[href="/my/inquiries"]').forEach(a => a.remove());
        // 개인 문의 화면도 가게 계정에는 없으니 받은 문의를 관리하는 화면으로 보낸다
        if (location.pathname === '/my/inquiries') { location.replace('/shop/inquiries'); return; }
        // 개인 이벤트 내역 화면은 가게 계정에 없으니 가게 이벤트 관리로 보낸다
        if (location.pathname === '/my/events') { location.replace('/shop/events'); return; }
        // 개인 경매 내역 화면도 가게 계정에 없으니 가게 경매 관리로 보낸다
        if (location.pathname === '/my/auctions') { location.replace('/shop/auctions'); return; }
        if (location.pathname === '/my/exchange') return;   // 개인 교환 내역 화면을 직접 연 경우는 그대로 둔다
        document.querySelectorAll('.my-tabs a[href="/my/exchange"]').forEach(a => {
            a.href = '/shop/exchange'; a.textContent = '가게 교환 관리';
            a.insertAdjacentHTML('beforebegin', '<a href="/shop/dashboard">대시보드</a>');
            a.insertAdjacentHTML('afterend', '<a href="/shop/items">판매 상품 관리</a><a href="/shop/events">이벤트 관리</a><a href="/shop/auctions">경매 관리</a><a href="/shop/inquiries">문의 관리</a><a href="/shop/reviews">리뷰 관리</a>');
        });
    })
    .catch(() => {});
</script>
