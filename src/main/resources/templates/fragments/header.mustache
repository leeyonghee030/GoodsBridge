<!doctype html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>GoodsBridge</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="nav-backdrop"></div>
<nav class="nav{{#isHome}} hero{{/isHome}}">
    <div class="logo-slot"><a href="/" class="logo">GoodsBridge</a></div>
    <div class="shop-dropdown" id="shop-dropdown">
        <button type="button" class="shop-dropdown-trigger" id="shop-trigger">전체 매장</button>
        <div class="shop-dropdown-menu" id="shop-menu" hidden>
            <label for="shop-menu-search" class="sr-only">매장 검색</label>
            <input type="text" id="shop-menu-search" class="shop-dropdown-search" placeholder="매장 검색" autocomplete="off">
            <ul id="shop-menu-list">
                <li data-value="" class="active">전체 매장</li>
            </ul>
        </div>
    </div>
    <!-- 실제 화면 나오기 전까지는 /test/* 로 임시 연결. 화면 교체 시 함께 수정 -->
    <div class="nav-item-mega">
        <a href="/test/item">SHOP</a>
        <div class="mega-menu">
            <div class="category-rank">
                <div class="category-list">
                    <h2>인기 상품 카테고리</h2>
                    <ol id="shop-category-rank-list">
                        <li><a href="/test/item?category=포토카드"><span>01</span>포토카드</a></li>
                        <li><a href="/test/item?category=앨범"><span>02</span>앨범</a></li>
                        <li><a href="/test/item?category=피규어"><span>03</span>피규어</a></li>
                        <li><a href="/test/item?category=응원봉"><span>04</span>응원봉</a></li>
                        <li><a href="/test/item?category=포스터"><span>05</span>포스터</a></li>
                    </ol>
                </div>
                <a href="/test/item?category=포토카드" class="category-photo has-image">
                    <img src="/img/nav-shop.jpg" alt="" class="category-photo-image">
                    <span class="category-photo-overlay">
                        <strong>포토카드</strong>
                        <span>자세히 보기</span>
                    </span>
                </a>
            </div>
            <div class="mega-menu-footer">SECURE DEPOSIT TRADE</div>
        </div>
    </div>
    <div class="nav-item-mega">
        <a href="/exchange">EXCHANGE</a>
        <div class="mega-menu">
            <div class="category-rank">
                <div class="category-list">
                    <h2>인기 교환 카테고리</h2>
                    <ol id="exchange-category-rank-list">
                        <li><a href="/exchange?categoryName=포토카드"><span>01</span>포토카드</a></li>
                        <li><a href="/exchange?categoryName=앨범"><span>02</span>앨범</a></li>
                        <li><a href="/exchange?categoryName=피규어"><span>03</span>피규어</a></li>
                        <li><a href="/exchange?categoryName=응원봉"><span>04</span>응원봉</a></li>
                        <li><a href="/exchange?categoryName=포스터"><span>05</span>포스터</a></li>
                    </ol>
                </div>
                <a href="/exchange?categoryName=포토카드" class="category-photo has-image">
                    <img src="/img/nav-exchange.jpg" alt="" class="category-photo-image">
                    <span class="category-photo-overlay">
                        <strong>포토카드</strong>
                        <span>자세히 보기</span>
                    </span>
                </a>
            </div>
            <div class="mega-menu-footer">NO-SHOW FREE EXCHANGE</div>
        </div>
    </div>
    <a href="/test/board">BOARD</a>
    {{#userId}}
    <a href="/my/exchange" id="nav-mypage">MY PAGE</a>
    <form action="/api/logout" method="post" class="inline-form"><button type="submit" class="link-button">LOGOUT</button></form>
    {{/userId}}
    {{^userId}}
    <button type="button" id="nav-login" class="link-button">LOGIN</button>
    {{/userId}}
</nav>
<div id="demo-switch" hidden>
    <button type="button" class="demo-toggle" aria-expanded="false">DEMO</button>
    <div class="demo-menu" hidden>
        <button type="button" data-demo="user-a">A</button>
        <button type="button" data-demo="user-b">B</button>
        <button type="button" data-demo="shop">가게</button>
        <button type="button" data-demo="admin">관리자</button>
        <button type="button" class="demo-reset" data-demo-reset>초기화</button>
    </div>
</div>

{{^userId}}
<div class="modal-backdrop" id="login-modal" hidden>
    <div class="modal-card">
        <button type="button" class="modal-close" id="login-modal-close">✕</button>
        <h1>로그인</h1>
        <form id="login-modal-form">
            <p>
                <label for="login-email" class="sr-only">이메일</label>
                <input id="login-email" type="email" name="email" placeholder="이메일" required>
            </p>
            <p>
                <label for="login-password" class="sr-only">비밀번호</label>
                <input id="login-password" type="password" name="password" placeholder="비밀번호" required>
            </p>
            <label class="checkbox-row">
                <input type="checkbox" name="rememberMe">
                로그인상태유지
            </label>
            <button type="submit">로그인</button>
        </form>
        <p id="login-modal-message" class="form-message"></p>
        <div class="link-row">
            <button type="button" class="link-button" id="open-signup">회원가입</button>
            <a href="/api/kakao-login">카카오 로그인</a>
        </div>
    </div>
</div>

<div class="modal-backdrop" id="signup-modal" hidden>
    <div class="modal-card">
        <button type="button" class="modal-close" id="signup-modal-close">✕</button>
        <h1>회원가입</h1>
        <form id="signup-modal-form">
            <p class="email-verify-row">
                <label for="signup-email-id" class="sr-only">이메일 아이디</label>
                <input id="signup-email-id" type="text" placeholder="이메일 아이디" required>
                <span class="email-at">@</span>
                <label for="signup-email-domain" class="sr-only">도메인</label>
                <input id="signup-email-domain" type="text" list="signup-email-domain-list" placeholder="도메인 (gmail.com)" required>
                <datalist id="signup-email-domain-list">
                    <option value="naver.com">
                    <option value="gmail.com">
                    <option value="daum.net">
                </datalist>
                <input type="hidden" id="signup-email" name="email">
                <button type="button" id="signup-send-btn">인증번호 전송</button>
            </p>
            <p class="code-verify-row" id="signup-code-box" hidden>
                <label for="signup-code" class="sr-only">인증번호</label>
                <input type="text" id="signup-code" placeholder="인증번호 입력" maxlength="10">
                <button type="button" id="signup-verify-btn">확인</button>
            </p>
            <p id="signup-verify-msg" class="form-message"></p>
            <p>
                <label for="signup-nickname" class="sr-only">닉네임</label>
                <input id="signup-nickname" type="text" name="nickname" placeholder="닉네임" required>
            </p>
            <p>
                <label for="signup-password" class="sr-only">비밀번호</label>
                <input id="signup-password" type="password" name="password" placeholder="비밀번호 (8~20자)" minlength="8" maxlength="20" required>
            </p>
            <p>
                <label for="signup-password-confirm" class="sr-only">비밀번호 확인</label>
                <input id="signup-password-confirm" type="password" placeholder="비밀번호 확인" minlength="8" maxlength="20" required>
            </p>
            <p id="signup-password-match-msg" class="form-message"></p>
            <p>
                <label for="signup-address" class="sr-only">배송지 주소</label>
                <input id="signup-address" type="text" placeholder="배송지 주소">
            </p>
            <button type="submit" id="signup-submit-btn">가입하기</button>
        </form>
        <p id="signup-modal-message" class="form-message"></p>
    </div>
</div>
{{/userId}}

<!-- 시연용 계정 전환 (app.demo.enabled=true 일 때만 /demo/status 가 응답해서 표시됨) -->
<style>
#demo-switch{position:fixed;top:5.5rem;right:1.5rem;z-index:90;transition:top .2s ease}
#demo-switch[hidden],#demo-switch .demo-menu[hidden]{display:none}
#demo-switch button{border:0;font:inherit;line-height:1.4}
#demo-switch .demo-toggle{padding:.15rem .6rem;border-radius:999px;background:var(--color-dark);color:#fff;font-size:.62rem;font-weight:700;letter-spacing:.08em;box-shadow:0 2px 8px rgba(0,0,0,.18)}
#demo-switch .demo-menu{position:absolute;top:calc(100% + 4px);right:0;display:flex;flex-direction:column;min-width:3.5rem;padding:3px;background:var(--color-dark);border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.18)}
#demo-switch .demo-menu button{padding:.25rem .7rem;border-radius:7px;background:transparent;color:#fff;font-size:.72rem;font-weight:500;text-align:left;white-space:nowrap}
#demo-switch .demo-menu button.active{background:#fff;color:var(--color-dark);font-weight:700}
#demo-switch .demo-menu .demo-reset{margin-top:3px;border-top:1px solid #444;border-radius:0 0 7px 7px;color:var(--color-muted)}
#demo-switch .demo-menu button:hover{background:#fff;color:var(--color-dark)}
</style>
<script>
fetch('/demo/status', { credentials: 'same-origin' })
    .then(res => res.ok ? res.json() : null)
    .then(data => {
        if (!data || !data.enabled) return;
        const bar = document.getElementById('demo-switch');
        const toggle = bar.querySelector('.demo-toggle');
        const menu = bar.querySelector('.demo-menu');
        bar.hidden = false;
        // 지금 선택된 계정 표시 (토글 라벨 + 메뉴 강조)
        const names = { 'user-a': 'A', 'user-b': 'B', 'shop': '가게', 'admin': '관리자' };
        if (names[data.current]) {
            toggle.textContent = 'DEMO · ' + names[data.current];
            bar.querySelector('[data-demo="' + data.current + '"]').classList.add('active');
        }
        // 헤더 높이가 바뀌어도(홈 큰 헤더 -> 작은 헤더) 항상 헤더 바로 아래에 붙도록 위치 갱신
        const nav = document.querySelector('.nav');
        const place = () => { bar.style.top = (nav.getBoundingClientRect().bottom + 8) + 'px'; };
        place();
        new ResizeObserver(place).observe(nav);
        nav.addEventListener('transitionend', place);
        window.addEventListener('resize', place);
        toggle.addEventListener('click', () => { menu.hidden = !menu.hidden; toggle.setAttribute('aria-expanded', String(!menu.hidden)); });
        document.addEventListener('click', e => { if (!bar.contains(e.target)) { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); } });
        bar.querySelector('[data-demo-reset]').addEventListener('click', async () => {
            if (!(await gbConfirm('시연 데이터를 처음 상태로 초기화할까요?\n교환 요청·댓글·구매 등 시연 중 만든 내용이 사라집니다.'))) return;
            const res = await fetch('/demo/reset', { method: 'POST', credentials: 'same-origin' });
            if (res.ok) location.reload(); else alert('초기화에 실패했습니다.');
        });
        bar.querySelectorAll('[data-demo]').forEach(btn => btn.addEventListener('click', async () => {
            const res = await fetch('/demo/login/' + btn.dataset.demo, { method: 'POST', credentials: 'same-origin' });
            if (res.ok) location.reload(); else alert('계정 전환에 실패했습니다.');
        }));
    })
    .catch(() => {});
</script>

{{#userId}}
