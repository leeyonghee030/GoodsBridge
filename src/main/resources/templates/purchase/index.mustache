{{> fragments/header}}
<section class="page-head">
    <p class="eyebrow">GOODBRIDGE · PURCHASE</p>
    <h1>상품 구매</h1>
    <p>상품을 선택하고 포트원 테스트 결제를 진행합니다.</p>
</section>

<section class="panel">
    <div class="section-title"><h2>판매 중인 상품</h2>
        <button id="reload-items" type="button">새로고침</button>
    </div>
    <div id="item-list"><p class="empty">상품을 불러오는 중입니다.</p></div>
</section>

<section class="panel" id="purchase-panel" hidden>
    <div class="section-title"><h2 id="selected-title">구매 정보</h2><strong id="selected-price"></strong></div>
    <label>배송지 <input id="delivery-address" type="text" placeholder="배송지 주소를 입력하세요"></label>
    <button id="pay-button" class="primary-button" type="button">포트원 테스트 결제</button>
    <p id="purchase-message" class="empty"></p>
</section>

<section class="panel">
    <div class="section-title"><h2>내 구매 내역</h2>
        <button id="reload-purchases" type="button">새로고침</button>
    </div>
    <div id="purchase-list"><p class="empty">구매 내역을 불러오는 중입니다.</p></div>
</section>

<section class="panel">
    <div class="section-title"><h2>가게 발송 관리</h2>
        <button id="reload-shop-purchases" type="button">불러오기</button>
    </div>
    <label>가게 ID <input id="shop-id" type="number" min="1" placeholder="내 가게 ID"></label>
    <label>배송 상태
        <select id="shop-status">
            <option value="PREPARING">배송 준비중</option>
            <option value="SHIPPED">배송중</option>
            <option value="DELIVERED">배송 완료</option>
            <option value="ALL">전체</option>
        </select>
    </label>
    <p id="shop-message" class="empty"></p>
    <div id="shop-purchase-list"><p class="empty">가게 ID를 입력하고 불러오세요.</p></div>
</section>

<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>
<script>
// 서버 에러 응답({"code","message","timestamp"})에서 사용자에게 보여줄 message만 꺼냄
const errorText = async (res, fallback) => {
    const text = await res.text();
    try { return JSON.parse(text).message || fallback; } catch (e) { return text || fallback; }
};

    (() => {
        const pageFetch = (path, options = {}) => fetch(path, Object.assign({credentials: 'same-origin'}, options));
        const userId = {{#userId}}{{userId}}{{/userId}}{{^userId}}null{{/userId}};
        const state = {items: [], selected: null};
        const $ = id => document.getElementById(id);
        const money = value => Number(value || 0).toLocaleString('ko-KR') + '원';
        const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, c => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#39;',
            '"': '&quot;'
        }[c]));
        const showMessage = (text, error = false) => {
            $('purchase-message').textContent = text || '';
            $('purchase-message').className = error ? 'error' : 'empty';
        };

        async function loadItems() {
            const response = await pageFetch('/api/items?page=0&size=50');
            if (!response.ok) throw new Error('상품 목록을 불러오지 못했습니다.');
            const page = await response.json();
            // 경매 상품은 경매 페이지에서만 구매하므로 일반 구매 목록에서 뺀다 (서버도 구매를 거절한다)
            state.items = (page.content || []).filter(item => item.status === 'ON_SALE' && item.saleType !== 'AUCTION');
            $('item-list').innerHTML = state.items.length ? state.items.map(item => `<article class="payment-row"><div><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.description || '')}</small></div><strong>${money(item.price)}</strong><button type="button" data-item="${item.id}">구매</button></article>`).join('') : '<p class="empty">판매 중인 상품이 없습니다.</p>';
            document.querySelectorAll('[data-item]').forEach(button => button.addEventListener('click', () => selectItem(Number(button.dataset.item))));
        }

        function selectItem(id) {
            state.selected = state.items.find(item => item.id === id);
            if (!state.selected) return;
            $('purchase-panel').hidden = false;
            $('selected-title').textContent = state.selected.title;
            $('selected-price').textContent = money(state.selected.price);
            showMessage('');
            $('purchase-panel').scrollIntoView({behavior: 'smooth', block: 'start'});
        }

        async function pay() {
            if (userId === null) {
                showMessage('로그인이 필요합니다.', true);
                const loginModal = document.getElementById('login-modal');
                if (loginModal) loginModal.hidden = false;
                return;
            }
            if (!state.selected) return showMessage('상품을 먼저 선택하세요.', true);
            const address = $('delivery-address').value.trim();
            if (!address) return showMessage('배송지 주소를 입력하세요.', true);
            if (!window.PortOne) return showMessage('포트원 SDK를 불러오지 못했습니다.', true);
            $('pay-button').disabled = true;
            showMessage('결제창을 여는 중입니다.');
            try {
                const result = await PortOne.requestPayment({
                    storeId: '{{portoneStoreId}}',
                    channelKey: '{{portoneChannelKey}}',
                    paymentId: `goodsbridge-${crypto.randomUUID()}`,
                    orderName: String(state.selected.title || '').trim() || `GoodsBridge 상품 #${state.selected.id}`,
                    totalAmount: state.selected.price,
                    currency: 'KRW',
                    payMethod: 'CARD'
                });
                if (result.code) throw new Error(result.message || '결제가 취소되었습니다.');
                const response = await pageFetch('/api/items/' + state.selected.id + '/purchase', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({paymentId: result.paymentId, deliveryAddress: address})
                });
                if (!response.ok) throw new Error(await errorText(response, '구매 처리에 실패했습니다.'));
                showMessage('결제와 구매 처리가 완료되었습니다.');
                await loadPurchases();
                await loadItems();
            } catch (error) {
                showMessage(error.message, true);
            } finally {
                $('pay-button').disabled = false;
            }
        }

        const deliveryLabels = {PREPARING: '배송 준비중', SHIPPED: '배송중', DELIVERED: '배송 완료'};
        const statusLabels = {PAID: '결제 완료', CONFIRMED: '수령 확인', REFUNDED: '환불'};
        const sourceLabels = {SHOP: '상점 구매', AUCTION: '경매 낙찰'};
        const showShopMessage = (text, error = false) => {
            $('shop-message').textContent = text || '';
            $('shop-message').className = error ? 'error' : 'empty';
        };

        async function loadPurchases() {
            const response = await pageFetch('/api/purchases/me');
            if (!response.ok) {
                $('purchase-list').innerHTML = '<p class="error">로그인 후 구매 내역을 확인할 수 있습니다.</p>';
                return;
            }
            const purchases = await response.json();
            // 구매자: 배송상태/운송장을 확인하고, 판매자가 배송 완료 처리한 구매만 수령 확인 버튼을 누를 수 있다.
            $('purchase-list').innerHTML = purchases.length ? purchases.map(item => {
                const canConfirm = item.status === 'PAID' && item.deliveryStatus === 'DELIVERED';
                return `<div class="payment-row"><div><strong>${escapeHtml(item.itemTitle || ('상품 #' + item.itemId))}</strong>`
                    + `<small>${escapeHtml(sourceLabels[item.source] || '상점 구매')}${item.amount != null ? ' · ' + Number(item.amount).toLocaleString('ko-KR') + '원' : ''}</small>`
                    + `<small>${escapeHtml(item.deliveryAddress || '')}</small>`
                    + `<small>${escapeHtml(deliveryLabels[item.deliveryStatus] || item.deliveryStatus || '')}`
                    + `${item.trackingNumber ? ' · 운송장 ' + escapeHtml(item.trackingNumber) : ''}</small></div>`
                    + `<span>${escapeHtml(statusLabels[item.status] || item.status || '')}</span>`
                    + `<small>${escapeHtml(item.paymentId)}</small>`
                    + (canConfirm ? `<button type="button" data-confirm="${item.id}">수령 확인</button>` : '')
                    + '</div>';
            }).join('') : '<p class="empty">구매 내역이 없습니다.</p>';
            document.querySelectorAll('[data-confirm]').forEach(button => button.addEventListener('click', () => confirmPurchase(button.dataset.confirm)));
        }

        async function confirmPurchase(id) {
            if (!confirm('상품을 받으셨나요? 수령 확인 후에는 대금이 판매자에게 지급됩니다.')) return;
            const response = await pageFetch('/api/purchases/' + id + '/confirm', {method: 'POST'});
            if (!response.ok) return showMessage(await response.text() || '수령 확인에 실패했습니다.', true);
            showMessage('수령 확인이 완료되었습니다.');
            await loadPurchases();
        }

        async function loadShopPurchases() {
            const shopId = Number($('shop-id').value);
            if (!shopId) return showShopMessage('가게 ID를 입력하세요.', true);
            const response = await pageFetch('/api/shops/' + shopId + '/purchases?status=' + encodeURIComponent($('shop-status').value));
            if (!response.ok) {
                $('shop-purchase-list').innerHTML = '';
                return showShopMessage(await response.text() || '발송 내역을 불러오지 못했습니다.', true);
            }
            showShopMessage('');
            const purchases = await response.json();
            // 판매자: 운송장 번호 입력(발송 처리) -> 배송중, 배송중 상품은 배송 완료 처리
            $('shop-purchase-list').innerHTML = purchases.length ? purchases.map(item => {
                const editable = item.status === 'PAID' && item.deliveryStatus !== 'DELIVERED';
                return `<div class="payment-row"><div><strong>상품 #${item.itemId}</strong><small>${escapeHtml(item.deliveryAddress || '')}</small>`
                    + `<small>${escapeHtml(deliveryLabels[item.deliveryStatus] || item.deliveryStatus || '')} · ${escapeHtml(statusLabels[item.status] || item.status || '')}</small></div>`
                    + (editable ? `<input id="tracking-${item.id}" type="text" maxlength="50" placeholder="운송장 번호" value="${escapeHtml(item.trackingNumber || '')}">`
                        + `<button type="button" data-ship="${item.id}">${item.deliveryStatus === 'SHIPPED' ? '운송장 수정' : '발송 처리'}</button>` : `<small>${escapeHtml(item.trackingNumber || '')}</small>`)
                    + (item.deliveryStatus === 'SHIPPED' ? `<button type="button" data-deliver="${item.id}">배송 완료</button>` : '')
                    + '</div>';
            }).join('') : '<p class="empty">해당 상태의 발송 내역이 없습니다.</p>';
            document.querySelectorAll('[data-ship]').forEach(button => button.addEventListener('click', () => {
                const trackingNumber = ($('tracking-' + button.dataset.ship).value || '').trim();
                if (!trackingNumber) return showShopMessage('운송장 번호를 입력하세요.', true);
                patchShipping(button.dataset.ship, {trackingNumber});
            }));
            document.querySelectorAll('[data-deliver]').forEach(button => button.addEventListener('click', () => patchShipping(button.dataset.deliver, {deliveryStatus: 'DELIVERED'})));
        }

        async function patchShipping(id, body) {
            const response = await pageFetch('/api/purchases/' + id + '/shipping', {
                method: 'PATCH',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(body)
            });
            if (!response.ok) return showShopMessage(await response.text() || '배송 정보 변경에 실패했습니다.', true);
            showShopMessage('배송 정보가 변경되었습니다.');
            await loadShopPurchases();
        }

        $('pay-button').addEventListener('click', pay);
        $('reload-items').addEventListener('click', () => loadItems().catch(error => $('item-list').innerHTML = `<p class="error">${escapeHtml(error.message)}</p>`));
        $('reload-purchases').addEventListener('click', loadPurchases);
        $('reload-shop-purchases').addEventListener('click', loadShopPurchases);
        $('shop-status').addEventListener('change', loadShopPurchases);
        loadItems().catch(error => $('item-list').innerHTML = `<p class="error">${escapeHtml(error.message)}</p>`);
        loadPurchases();
    })();
</script>
{{> fragments/footer}}
