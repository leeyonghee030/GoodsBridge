{{> fragments/header}}

<style>
    .dashboard {
        display: grid;
        gap: 1.5rem;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .dashboard-filter {
        display: flex;
        gap: .5rem;
    }

    .dashboard-filter input,
    .dashboard-filter button {
        padding: .6rem .8rem;
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    .dashboard-filter button {
        cursor: pointer;
        background: #222;
        color: #fff;
    }

    .dashboard-chart {
        padding: 1.5rem;
        border: 1px solid #e8e8e8;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .05);
    }

    .dashboard-chart h2 {
        margin-top: 0;
    }

    .dashboard-message {
        color: #777;
    }

    .dashboard-error {
        color: #c62828;
    }
</style>

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1>관리자 대시보드</h1>
            <p id="selected-month">통계를 불러오는 중입니다.</p>
        </div>

        <form id="dashboard-form" class="dashboard-filter">
            <input id="month" type="month" required>
            <button type="submit">조회</button>
        </form>
    </div>

    <p id="dashboard-message" class="dashboard-message">
        통계를 불러오는 중입니다.
    </p>

    <section class="dashboard-chart">
        <h2>전체 가입자 수</h2>
        <canvas id="user-count-chart"></canvas>
    </section>

    <section class="dashboard-chart">
        <h2>거래량</h2>
        <p id="payment-amount">거래 금액 합계를 불러오는 중입니다.</p>
        <canvas id="payment-count-chart"></canvas>
    </section>

    <section class="dashboard-chart">
        <h2>월 매출</h2>
        <canvas id="revenue-chart"></canvas>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    (() => {
        const pageFetch = (path, options = {}) =>
            fetch(path, Object.assign({ credentials: 'same-origin' }, options));
        const form = document.getElementById('dashboard-form');
        const monthInput = document.getElementById('month');
        const selectedMonth = document.getElementById('selected-month');
        const message = document.getElementById('dashboard-message');
        const paymentAmount = document.getElementById('payment-amount');

        let userCountChart = null;
        let paymentCountChart = null;
        let revenueChart = null;

        const currentMonth = new Date().toISOString().slice(0, 7);
        monthInput.value = currentMonth;

        async function loadDashboard(month) {
            message.textContent = '통계를 불러오는 중입니다.';
            message.className = 'dashboard-message';

            try {
                const response = await pageFetch(
                    '/api/admin/dashboard?month=' + encodeURIComponent(month)
                );

                if (!response.ok) {
                    if (response.status === 403) {
                        throw new Error('관리자 권한이 필요합니다.');
                    }

                    if (response.status === 400) {
                        throw new Error('날짜 형식이 올바르지 않습니다.');
                    }

                    throw new Error('대시보드 통계를 불러오지 못했습니다.');
                }

                const data = await response.json();

                selectedMonth.textContent = month + ' 기준 통계';
                message.textContent = '통계 조회가 완료되었습니다.';
                paymentAmount.textContent = '거래 금액 합계: ' + Number(data.paymentAmount || 0).toLocaleString('ko-KR') + '원';

                renderCharts(month, data);
            } catch (error) {
                message.textContent = error.message;
                message.className = 'dashboard-error';
            }
        }

        function renderCharts(month, data) {
            if (userCountChart) {
                userCountChart.destroy();
            }

            if (paymentCountChart) {
                paymentCountChart.destroy();
            }

            if (revenueChart) {
                revenueChart.destroy();
            }

            userCountChart = new Chart(
                document.getElementById('user-count-chart'),
                {
                    type: 'bar',
                    data: {
                        labels: [month],
                        datasets: [
                            {
                                label: '전체 가입자 수',
                                data: [data.userCount],
                                backgroundColor: '#4f46e5'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                }
            );

            paymentCountChart = new Chart(
                document.getElementById('payment-count-chart'),
                {
                    type: 'bar',
                    data: {
                        labels: [month],
                        datasets: [
                            {
                                label: '거래량',
                                data: [data.paymentCount],
                                backgroundColor: '#16a34a'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                }
            );

            revenueChart = new Chart(
                document.getElementById('revenue-chart'),
                {
                    type: 'bar',
                    data: {
                        labels: [month],
                        datasets: [
                            {
                                label: '월 매출',
                                data: [data.revenue],
                                backgroundColor: '#dc2626'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) {
                                        return Number(value)
                                            .toLocaleString('ko-KR') + '원';
                                    }
                                }
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return Number(context.raw)
                                            .toLocaleString('ko-KR') + '원';
                                    }
                                }
                            }
                        }
                    }
                }
            );
        }

        form.addEventListener('submit', function (event) {
            event.preventDefault();

            if (!monthInput.value) {
                message.textContent = '조회할 월을 선택해주세요.';
                message.className = 'dashboard-error';
                return;
            }

            loadDashboard(monthInput.value);
        });

        loadDashboard(monthInput.value);
    })();
</script>

{{> fragments/footer}}
