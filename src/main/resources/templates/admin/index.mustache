{{> fragments/header}}


<style>
.dash { display: grid; gap: 1.25rem; }
.dash-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; }
.dash-head h1 { margin: 0; font-size: 1.15rem; }
.dash-head p { margin: 0.2rem 0 0; font-size: 0.84rem; color: var(--color-muted); }
.dash-filter { display: flex; gap: 0.4rem; margin: 0; }
.dash-filter input { width: auto; padding: 0.4rem 0.7rem; border: 1px solid var(--color-border); border-radius: 8px; font: inherit; font-size: 0.86rem; background: #fff; }
.dash-filter button { width: auto; margin: 0; padding: 0.4rem 0.9rem; border-radius: 8px; font-size: 0.86rem; }
.dash-panel { border: 1px solid var(--color-border); border-radius: 14px; background: #fff; padding: 1.1rem 1.25rem; }
.dash-panel h2 { margin: 0 0 0.2rem; font-size: 1rem; }
.dash-note { margin: 0; font-size: 0.8rem; color: var(--color-muted); }
.dash-error { color: #C0392B; }
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; margin-top: 0.9rem; }
.kpi { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 0.9rem; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); }
.kpi-icon { flex: none; width: 38px; height: 38px; display: grid; place-items: center; font-size: 1.1rem; border-radius: 10px; background: #fff; }
.kpi small { display: block; margin-bottom: 0.15rem; font-size: 0.78rem; color: var(--color-muted); }
.kpi strong { font-size: 1.15rem; }
.kpi.is-alert { border-color: #F0C4BE; background: #FDECEA; }
.kpi.is-alert strong { color: #C0392B; }
.chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-top: 0.9rem; }
.chart-box h3 { margin: 0 0 0.4rem; font-size: 0.9rem; }
.chart-canvas { position: relative; height: 220px; }
</style>

{{^isAdmin}}
<div class="container my-card">
    <p class="as-empty" style="padding:3rem 0;text-align:center;color:var(--color-muted)">관리자만 이용할 수 있는 페이지입니다. <a href="/">홈으로 돌아가기</a></p>
</div>
{{/isAdmin}}

{{#isAdmin}}
<div class="container my-card">
<nav class="my-tabs">
    <a href="/test/admin" class="active">대시보드</a>
    <a href="/test/admin/shops">입점 관리</a>
    <a href="/test/admin/subscriptions">구독 관리</a>
</nav>
    <div class="dash">
        <div class="dash-head">
            <div>
                <h1>관리자 대시보드</h1>
                <p id="selected-month">통계를 불러오는 중입니다.</p>
            </div>

            <form id="dashboard-form" class="dash-filter">
                <input id="month" type="month" required>
                <button type="submit">조회</button>
            </form>
        </div>

        <p id="dashboard-message" class="dash-note">통계를 불러오는 중입니다.</p>

        <section class="dash-panel">
            <h2>처리 대기 현황</h2>
            <p class="dash-note">월과 무관한 현재 값입니다. 빨간색은 처리가 필요한 항목입니다.</p>
            <div id="pending-cards" class="kpi-grid"></div>
        </section>

        <section class="dash-panel">
            <h2>월 운영 지표</h2>
            <p class="dash-note">플랫폼 매출은 가게 구독료, 가게 매출은 일반 판매 대금·교환 수수료·노쇼 몰수금·경매 낙찰가·이벤트 참가비입니다.</p>
            <div id="month-cards" class="kpi-grid"></div>
        </section>

        <section class="dash-panel">
            <h2>최근 6개월 추이</h2>
            <div class="chart-grid">
                <div class="chart-box">
                    <h3>월 가입자 수</h3>
                    <div class="chart-canvas"><canvas id="signup-chart"></canvas></div>
                </div>
                <div class="chart-box">
                    <h3>월 매출</h3>
                    <div class="chart-canvas"><canvas id="revenue-chart"></canvas></div>
                </div>
                <div class="chart-box">
                    <h3>월 거래 건수</h3>
                    <div class="chart-canvas"><canvas id="payment-chart"></canvas></div>
                </div>
            </div>
        </section>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>

    <script>
        (() => {
            const form = document.getElementById('dashboard-form');
            const monthInput = document.getElementById('month');
            const selectedMonth = document.getElementById('selected-month');
            const message = document.getElementById('dashboard-message');

            const charts = {};
            const errorMessage = {
                400: '날짜 형식이 올바르지 않습니다.',
                403: '관리자 권한이 필요합니다.'
            };

            const won = value => Number(value || 0).toLocaleString('ko-KR') + '원';
            const count = value => Number(value || 0).toLocaleString('ko-KR') + '건';
            const person = value => Number(value || 0).toLocaleString('ko-KR') + '명';

            // 오늘 기준 이번 달(브라우저 현지 시간)을 YYYY-MM으로 만든다.
            const now = new Date();
            monthInput.value = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');

            async function loadDashboard(month) {
                message.textContent = '통계를 불러오는 중입니다.';
                message.className = 'dash-note';

                try {
                    const response = await fetch(
                        '/api/admin/dashboard?month=' + encodeURIComponent(month),
                        {credentials: 'same-origin'}
                    );

                    if (!response.ok) {
                        message.textContent = errorMessage[response.status] || '대시보드 통계를 불러오지 못했습니다.';
                        message.className = 'dash-note dash-error';
                        return;
                    }

                    const data = await response.json();
                    selectedMonth.textContent = month + ' 기준 통계';
                    message.textContent = '통계 조회가 완료되었습니다.';

                    renderCards(data);
                    renderCharts(data.months);
                } catch (error) {
                    message.textContent = '서버와 통신하지 못했습니다.';
                    message.className = 'dash-note dash-error';
                }
            }

            // 카드 하나를 만든다. 값은 textContent로 넣어서 HTML이 섞이지 않게 한다.
            function addCard(container, icon, title, value, alert) {
                const card = document.createElement('div');
                card.className = 'kpi' + (alert ? ' is-alert' : '');

                const iconBox = document.createElement('div');
                iconBox.className = 'kpi-icon';
                iconBox.textContent = icon;

                const body = document.createElement('div');
                const label = document.createElement('small');
                label.textContent = title;
                const strong = document.createElement('strong');
                strong.textContent = value;

                body.append(label, strong);
                card.append(iconBox, body);
                container.appendChild(card);
            }

            function renderCards(data) {
                const pending = document.getElementById('pending-cards');
                const monthly = document.getElementById('month-cards');
                pending.replaceChildren();
                monthly.replaceChildren();

                // 마지막 인자가 true면 처리가 필요한 항목으로 빨갛게 표시한다
                addCard(pending, '💸', '환불 승인 대기', count(data.pendingRefundCount), data.pendingRefundCount > 0);
                addCard(pending, '📦', '발송 대기', count(data.pendingShipmentCount), data.pendingShipmentCount > 0);
                addCard(pending, '🔨', '진행 중 경매', count(data.activeAuctionCount), false);
                addCard(pending, '🏁', '종료된 경매', count(data.endedAuctionCount), false);
                addCard(pending, '⏳', '잔금 미납 낙찰', count(data.unpaidBalanceCount), data.unpaidBalanceCount > 0);

                // 마지막 원소가 조회한 달이다.
                const m = data.months[data.months.length - 1];
                addCard(monthly, '👤', '월 가입자 수', person(m.signupCount), false);
                addCard(monthly, '🧾', '월 거래 건수', count(m.paymentCount), false);
                addCard(monthly, '🏦', '월 정산 금액', won(m.settlementAmount), false);
                addCard(monthly, '↩️', '월 환불 금액', won(m.refundedAmount), false);
                addCard(monthly, '🏢', '플랫폼 월 매출', won(m.platformRevenue), false);
                addCard(monthly, '🏪', '가게 월 매출', won(m.shopRevenue), false);
            }

            // 가로 막대 그래프 하나를 그린다. format은 값 뒤에 단위를 붙이는 함수다.
            function drawChart(canvasId, labels, datasets, format) {
                if (charts[canvasId]) {
                    charts[canvasId].destroy();
                }

                charts[canvasId] = new Chart(document.getElementById(canvasId), {
                    type: 'bar',
                    data: {labels: labels, datasets: datasets},
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: {precision: 0, callback: value => format(value)}
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {label: context => context.dataset.label + ': ' + format(context.raw)}
                            }
                        }
                    }
                });
            }

            function renderCharts(months) {
                const labels = months.map(m => m.month);

                drawChart('signup-chart', labels, [
                    {label: '가입자 수', data: months.map(m => m.signupCount), backgroundColor: '#f59e0b'}
                ], person);

                drawChart('revenue-chart', labels, [
                    {label: '플랫폼(구독료)', data: months.map(m => m.platformRevenue), backgroundColor: '#7c3aed'},
                    {label: '가게', data: months.map(m => m.shopRevenue), backgroundColor: '#db2777'}
                ], won);

                drawChart('payment-chart', labels, [
                    {label: '거래 건수', data: months.map(m => m.paymentCount), backgroundColor: '#16a34a'}
                ], count);
            }

            // 월이 비어 있는 경우는 input의 required가 막아 주므로 따로 검사하지 않는다.
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                loadDashboard(monthInput.value);
            });

            loadDashboard(monthInput.value);
        })();
    </script>
{{/isAdmin}}

{{> fragments/footer}}
