{{> fragments/header}}

<!-- 관리자: 고객센터 문의. 글을 펼쳐 내용을 읽고 바로 답글을 남긴다 (답글을 달면 "답변 완료"로 바뀐다) -->
<div class="container my-card">
    <nav class="my-tabs">
        <a href="/test/admin">대시보드</a>
        <a href="/test/admin/shops">입점 관리</a>
        <a href="/test/admin/subscriptions">구독 관리</a>
        <a href="/test/admin/subscription-payments">구독 결제 내역</a>
        <a href="/test/admin/auctions">경매 관리</a>
        <a href="/test/admin/support" class="active">고객센터 문의</a>
    </nav>

    <div class="mb-subtabs" id="sp-status"></div>
    <section class="mb-panel">
        <div id="sp-list" class="sp-list"></div>
        <p id="sp-empty" class="mb-empty" hidden></p>
        <button type="button" id="sp-more" class="mb-more" hidden>더 보기</button>
    </section>
</div>

<script>
(() => {
    const STATUS = [['ALL', '전체'], ['PENDING', '답변 대기'], ['COMPLETED', '답변 완료']];
    const listEl = document.getElementById('sp-list');
    const emptyEl = document.getElementById('sp-empty');
    const moreEl = document.getElementById('sp-more');
    let status = 'PENDING';
    let nextPage = 0;
    let last = true;
    let counts = {};

    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const when = iso => (iso || '').replace('T', ' ').slice(0, 16);
    const errorText = async (res, fallback) => {
        const text = await res.text();
        try { return JSON.parse(text).message || fallback; } catch (e) { return text || fallback; }
    };

    function renderTabs() {
        document.getElementById('sp-status').innerHTML = STATUS.map(([key, label]) =>
            `<button type="button" data-status="${key}" class="${status === key ? 'active' : ''}">${label}<small>${counts[key] ?? ''}</small></button>`).join('');
    }

    function rowHtml(r) {
        const wait = r.status === 'PENDING';
        return `<div class="sp-row" data-id="${r.id}">
            <button type="button" class="sp-head" aria-expanded="false">
                <span class="mb-main"><strong>${esc(r.title)}</strong><small>${esc(r.authorNickname)} · ${when(r.createdAt)}</small></span>
                <span class="mb-badge ${wait ? 'is-wait' : 'is-done'}">${wait ? '답변 대기' : '답변 완료'}</span>
            </button>
            <div class="sp-body" hidden>
                <p class="sp-question">${esc(r.content)}</p>
                <form class="sp-form">
                    <textarea rows="3" placeholder="답변을 입력하세요" required></textarea>
                    <div class="sp-actions">
                        <a href="/test/board/${r.id}" class="sp-link">상세 보기</a>
                        <button type="submit" class="mb-btn is-primary">답변 등록</button>
                    </div>
                    <p class="form-message"></p>
                </form>
            </div>
        </div>`;
    }

    async function load(reset) {
        if (reset) { nextPage = 0; listEl.innerHTML = ''; }
        const query = new URLSearchParams({ page: nextPage, size: 10, sort: 'id,desc' });
        if (status !== 'ALL') query.set('status', status);
        const res = await fetch('/api/boards/admin/support?' + query.toString(), { credentials: 'same-origin' });
        if (!res.ok) { emptyEl.textContent = '문의를 불러오지 못했어요.'; emptyEl.hidden = false; return; }
        const page = await res.json();
        listEl.insertAdjacentHTML('beforeend', (page.content || []).map(rowHtml).join(''));
        last = !!page.last;
        nextPage += 1;
        const none = listEl.children.length === 0;
        emptyEl.hidden = !none;
        if (none) emptyEl.textContent = status === 'PENDING' ? '답변을 기다리는 문의가 없어요.' : '문의가 없어요.';
        moreEl.hidden = last;
    }

    async function loadCounts() {
        const res = await fetch('/api/boards/admin/support/counts', { credentials: 'same-origin' });
        if (res.ok) counts = await res.json();
        renderTabs();
    }

    document.getElementById('sp-status').addEventListener('click', event => {
        const button = event.target.closest('[data-status]');
        if (!button) return;
        status = button.dataset.status;
        renderTabs();
        load(true);
    });
    moreEl.addEventListener('click', () => load(false));

    listEl.addEventListener('click', event => {
        const head = event.target.closest('.sp-head');
        if (!head) return;
        const body = head.nextElementSibling;
        body.hidden = !body.hidden;
        head.setAttribute('aria-expanded', String(!body.hidden));
        if (!body.hidden) body.querySelector('textarea').focus();
    });

    listEl.addEventListener('submit', async event => {
        event.preventDefault();
        const row = event.target.closest('.sp-row');
        const textarea = row.querySelector('textarea');
        const message = row.querySelector('.form-message');
        const submit = row.querySelector('[type="submit"]');
        submit.disabled = true;
        const res = await fetch('/api/boards/' + row.dataset.id + '/replies', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: textarea.value.trim() })
        });
        submit.disabled = false;
        if (!res.ok) { message.textContent = await errorText(res, '답변 등록에 실패했습니다.'); message.className = 'form-message error'; return; }
        // 답변 대기 목록에서는 사라지고, 개수가 갱신된다
        await loadCounts();
        load(true);
    });

    renderTabs();
    loadCounts();
    load(true);
})();
</script>

{{> fragments/footer}}
