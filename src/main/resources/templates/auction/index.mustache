{{> fragments/header}}

<style>
/* 카드 정보는 한 줄로 (넘치면 말줄임) */
.au-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
.au-price small { margin-right: 0.35rem; font-size: 0.72rem; font-weight: 500; color: var(--color-muted); }
.au-hot { color: #C0392B; }
/* 정렬 메뉴는 글자가 두 줄로 꺾이지 않게 메뉴 폭을 내용에 맞춘다 */
#sort-menu { min-width: 100%; width: max-content; left: auto; right: 0; }
#sort-menu .scope-menu-item { white-space: nowrap; }
</style>

<h1 class="page-title">경매</h1>
<p id="shop-filter-info" class="card-meta shop-filter-info" hidden></p>

<div class="list-toolbar">
    <span class="list-toolbar-category" id="toolbar-label">진행중</span>
    <div class="list-toolbar-actions">
        <div class="scope-dropdown" id="scope-dropdown">
            <button type="button" class="write-link" id="scope-trigger">진행중</button>
            <div class="scope-menu" id="scope-menu" hidden>
                <button type="button" class="scope-menu-item active" data-tab="ACTIVE">진행중</button>
                <button type="button" class="scope-menu-item" data-tab="MINE">내 입찰</button>
                <button type="button" class="scope-menu-item" data-tab="ENDED">종료</button>
            </div>
        </div>
        <div class="scope-dropdown" id="sort-dropdown">
            <button type="button" class="write-link" id="sort-trigger">마감 임박순</button>
            <div class="scope-menu" id="sort-menu" hidden>
                <button type="button" class="scope-menu-item active" data-sort="DEADLINE">마감 임박순</button>
                <button type="button" class="scope-menu-item" data-sort="NEWEST">최근 등록순</button>
                <button type="button" class="scope-menu-item" data-sort="PRICE_DESC">현재가 높은순</button>
                <button type="button" class="scope-menu-item" data-sort="PRICE_ASC">현재가 낮은순</button>
                <button type="button" class="scope-menu-item" data-sort="BIDS">입찰 많은순</button>
            </div>
        </div>
        <label for="keyword-input" class="sr-only">검색</label>
        <input type="text" id="keyword-input" class="toolbar-search" placeholder="상품명 · 가게 검색" autocomplete="off">
    </div>
</div>

<div class="card-grid" id="item-grid"></div>
<p class="empty-state" id="empty-state">경매를 불러오는 중...</p>

<script>
(() => {
    const pageFetch = (path, options = {}) => fetch(path, Object.assign({ credentials: 'same-origin' }, options));
    const money = v => Number(v || 0).toLocaleString('ko-KR') + '원';
    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const userId = {{#userId}}{{userId}}{{/userId}}{{^userId}}null{{/userId}};

    const grid = document.getElementById('item-grid');
    const emptyEl = document.getElementById('empty-state');
    const keywordInput = document.getElementById('keyword-input');
    const TAB_LABELS = { ACTIVE: '진행중', MINE: '내 입찰', ENDED: '종료' };
    const SORT_LABELS = { DEADLINE: '마감 임박순', NEWEST: '최근 등록순', PRICE_DESC: '현재가 높은순', PRICE_ASC: '현재가 낮은순', BIDS: '입찰 많은순' };
    let auctions = [];
    let mine = new Set();      // 내가 입찰한 경매 id
    let tab = 'ACTIVE';
    let sortKey = 'DEADLINE';

    // 마감시간이 지났으면 상태가 ACTIVE 여도(스케줄러 반영 전) 마감으로 본다
    const deadlineOf = a => new Date(a.deadline);
    const isLive = a => a.status === 'ACTIVE' && deadlineOf(a) > new Date();
    const statusLabel = a => a.status === 'CANCELLED' ? '취소'
        : a.status === 'ENDED_SUCCESS' ? '낙찰'
        : a.status === 'ENDED_FAIL' ? '유찰'
        : !isLive(a) ? '마감 처리 중' : '진행중';

    // 남은 시간: 하루 이상이면 D-n, 하루 안이면 시:분:초
    function leftText(a) {
        if (!isLive(a)) return '종료';
        const ms = deadlineOf(a) - new Date();
        const s = Math.floor(ms / 1000), d = Math.floor(s / 86400);
        if (d > 0) return `D-${d}`;
        const pad = n => String(n).padStart(2, '0');
        return `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s % 3600 / 60))}:${pad(s % 60)}`;
    }
    const isSoon = a => isLive(a) && deadlineOf(a) - new Date() < 3600 * 1000;

    // 헤더의 '전체 매장' 선택을 교환 게시판처럼 따른다
    const selectedShopId = () => { try { return localStorage.getItem('gb_shop_id') || ''; } catch (e) { return ''; } };

    function sortList(list) {
        const by = {
            DEADLINE: (a, b) => (isLive(b) - isLive(a)) || (isLive(a) ? deadlineOf(a) - deadlineOf(b) : deadlineOf(b) - deadlineOf(a)),
            NEWEST: (a, b) => b.id - a.id,
            PRICE_DESC: (a, b) => b.currentPrice - a.currentPrice,
            PRICE_ASC: (a, b) => a.currentPrice - b.currentPrice,
            BIDS: (a, b) => b.bidCount - a.bidCount || deadlineOf(a) - deadlineOf(b)
        }[sortKey];
        return [...list].sort(by);
    }

    function rows() {
        const kw = keywordInput.value.trim().toLowerCase();
        const shopId = selectedShopId();
        return sortList(auctions)
            .filter(a => tab === 'MINE' ? mine.has(a.id) : tab === 'ENDED' ? !isLive(a) : isLive(a))
            .filter(a => !shopId || String(a.shopId) === shopId)
            .filter(a => !kw || `${a.itemTitle} ${a.shopName}`.toLowerCase().includes(kw));
    }

    function myTag(a) {
        if (!mine.has(a.id)) return '';
        return a.currentWinnerUserId === userId ? ' · 내가 최고가' : ' · 내 입찰';
    }

    function render() {
        const list = rows();
        grid.innerHTML = list.map(a => `
            <a class="card" href="/test/auction/${a.id}">
                <span class="card-tag">■ ${statusLabel(a)}${myTag(a)}</span>
                <div class="card-image">${a.itemImageUrl ? `<img src="${esc(a.itemImageUrl)}" alt="${esc(a.itemTitle)}">` : '이미지 없음'}</div>
                <p class="card-title">${esc(a.itemTitle)}</p>
                <p class="card-price au-price"><small>${a.bidCount ? '현재가' : '시작가'}</small>${money(a.currentPrice)}</p>
                <p class="card-meta au-line">입찰 ${a.bidCount}회 · 보증금 ${money(a.depositAmount)} · <span data-left="${a.id}" class="${isSoon(a) ? 'au-hot' : ''}">${leftText(a)}</span></p>
                <p class="card-meta au-line">${esc(a.shopName)}</p>
            </a>`).join('');
        const msg = { ACTIVE: '지금 진행 중인 경매가 없어요.', MINE: userId === null ? '로그인하면 내가 입찰한 경매를 볼 수 있어요.' : '입찰한 경매가 없어요.', ENDED: '종료된 경매가 없어요.' }[tab];
        emptyEl.textContent = keywordInput.value.trim() ? '검색 결과가 없어요.' : msg;
        emptyEl.hidden = list.length > 0;
    }

    async function load() {
        try {
            const res = await pageFetch('/api/auctions?page=1&size=50');
            if (!res.ok) throw new Error('경매를 불러오지 못했어요.');
            auctions = (await res.json()).content || [];
            if (userId !== null) {
                const meRes = await pageFetch('/api/auctions/me?page=0&size=50');
                if (meRes.ok) mine = new Set(((await meRes.json()).content || []).map(a => a.id));
            }
            render();
        } catch (e) {
            emptyEl.textContent = e.message;
            emptyEl.hidden = false;
        }
    }

    // 남은 시간만 1초마다 갱신
    setInterval(() => {
        document.querySelectorAll('[data-left]').forEach(el => {
            const a = auctions.find(x => x.id === Number(el.dataset.left));
            if (a) { el.textContent = leftText(a); el.classList.toggle('au-hot', isSoon(a)); }
        });
    }, 1000);

    // 상태 선택 / 정렬 선택 (이벤트 목록과 같은 모양의 드롭다운)
    const scopeTrigger = document.getElementById('scope-trigger');
    const scopeMenu = document.getElementById('scope-menu');
    const sortTrigger = document.getElementById('sort-trigger');
    const sortMenu = document.getElementById('sort-menu');
    document.getElementById('scope-dropdown').addEventListener('click', ev => {
        ev.stopPropagation();
        sortMenu.hidden = true;
        if (ev.target === scopeTrigger) { scopeMenu.hidden = !scopeMenu.hidden; return; }
        const item = ev.target.closest('.scope-menu-item');
        if (!item) return;
        tab = item.dataset.tab;
        scopeTrigger.textContent = TAB_LABELS[tab];
        document.getElementById('toolbar-label').textContent = TAB_LABELS[tab];
        scopeMenu.querySelectorAll('.scope-menu-item').forEach(el => el.classList.toggle('active', el === item));
        scopeMenu.hidden = true;
        render();
    });
    document.getElementById('sort-dropdown').addEventListener('click', ev => {
        ev.stopPropagation();
        scopeMenu.hidden = true;
        if (ev.target === sortTrigger) { sortMenu.hidden = !sortMenu.hidden; return; }
        const item = ev.target.closest('.scope-menu-item');
        if (!item) return;
        sortKey = item.dataset.sort;
        sortTrigger.textContent = SORT_LABELS[sortKey];
        sortMenu.querySelectorAll('.scope-menu-item').forEach(el => el.classList.toggle('active', el === item));
        sortMenu.hidden = true;
        render();
    });
    document.addEventListener('click', () => { scopeMenu.hidden = true; sortMenu.hidden = true; });
    keywordInput.addEventListener('input', render);

    // 헤더에서 매장을 고르면 안내 문구를 보여준다
    const shopInfo = document.getElementById('shop-filter-info');
    const shopId = selectedShopId();
    if (shopId) {
        pageFetch('/api/shops/' + shopId).then(res => res.ok ? res.json() : null).then(shop => {
            if (!shop) { shopInfo.hidden = true; return; }
            shopInfo.textContent = `${shop.name} · ${shop.region || ''} 매장 경매만 보고 있습니다.`;
            shopInfo.hidden = false;
        });
    }
    load();
})();
</script>

{{> fragments/footer}}
