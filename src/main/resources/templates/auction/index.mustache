{{> fragments/header}}
<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>

<h1 class="page-title">AUCTION</h1>

{{^auctions}}
<p class="empty-state">진행 중인 경매가 없습니다.</p>
{{/auctions}}

<div class="card-grid">
{{#auctions}}
    <div class="card" data-auction-id="{{id}}" data-item-id="{{itemId}}" data-deposit="{{depositAmount}}" data-current="{{currentPrice}}">
        <span class="card-tag">{{status}}</span>
        <div class="card-image auction-card-image">이미지 불러오는 중</div>
        <p class="card-title auction-card-title">상품 정보 불러오는 중</p>
        <p class="card-price">현재가 {{currentPrice}}원</p>
        <p class="card-meta">보증금 {{depositAmount}}원 · 마감 {{deadline}}</p>
        <p>
            <input type="number" class="bid-input" placeholder="입찰 금액" min="{{currentPrice}}" step="1000">
        </p>
        <button type="button" class="auction-bid-btn">입찰하기</button>
        <p class="form-message"></p>
    </div>
{{/auctions}}
</div>

<script>
(() => {
    const pageFetch = (path, options = {}) => fetch(path, Object.assign({ credentials: 'same-origin' }, options));
    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const portoneStoreId = '{{portoneStoreId}}';
    const portoneChannelKey = '{{portoneChannelKey}}';

    document.querySelectorAll('.card[data-item-id]').forEach(async card => {
        const itemId = card.dataset.itemId;
        const res = await pageFetch('/api/items/' + itemId);
        if (!res.ok) return;
        const item = await res.json();
        const imageBox = card.querySelector('.auction-card-image');
        imageBox.innerHTML = item.imageUrl ? `<img src="${esc(item.imageUrl)}" alt="${esc(item.title)}">` : '이미지 없음';
        card.querySelector('.auction-card-title').textContent = item.title;
    });

    document.querySelectorAll('.auction-bid-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const card = btn.closest('.card');
            const message = card.querySelector('.form-message');
            const auctionId = card.dataset.auctionId;
            const deposit = Number(card.dataset.deposit);
            const currentPrice = Number(card.dataset.current);
            const bidAmount = Number(card.querySelector('.bid-input').value);
            if (!bidAmount || bidAmount <= currentPrice) { message.textContent = '현재가보다 높은 금액을 입력하세요.'; message.className = 'form-message error'; return; }
            if (!window.PortOne) { message.textContent = '포트원 SDK를 불러오지 못했습니다.'; message.className = 'form-message error'; return; }
            message.textContent = '결제창을 여는 중입니다.'; message.className = 'form-message';
            try {
                const result = await PortOne.requestPayment({
                    storeId: portoneStoreId, channelKey: portoneChannelKey,
                    paymentId: `goodsbridge-auction-${crypto.randomUUID()}`,
                    orderName: '경매 보증금', totalAmount: deposit, currency: 'KRW', payMethod: 'CARD'
                });
                if (result.code) throw new Error(result.message || '결제가 취소되었습니다.');
                const res = await pageFetch('/api/auctions/' + auctionId + '/bids', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ bidAmount, paymentId: result.paymentId })
                });
                if (!res.ok) throw new Error(await res.text() || '입찰에 실패했습니다.');
                message.textContent = '입찰이 완료되었습니다!'; message.className = 'form-message';
                card.dataset.current = bidAmount;
                card.querySelector('.card-price').textContent = '현재가 ' + bidAmount + '원';
            } catch (error) {
                message.textContent = error.message; message.className = 'form-message error';
            }
        });
    });
})();
</script>

{{> fragments/footer}}
