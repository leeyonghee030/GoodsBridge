{{> fragments/header}}
<section class="page-head">
    <p class="eyebrow">GOODBRIDGE · SETTLEMENT</p>
    <h1>가게 매출 내역</h1>
    <p>정산 내역과 구독료를 반영한 순매출을 확인합니다.</p>
</section>

<section class="panel">
    <div class="section-title"><h2>조회 조건</h2>
        <button id="reload" type="button">조회</button>
    </div>
    <label>가게 <select id="shop"></select></label>
    <label>유형
        <select id="type">
            <option value="">전체</option>
        </select>
    </label>
    <label>시작일 <input id="from" type="date"></label>
    <label>종료일 <input id="to" type="date"></label>
    <p id="message" class="empty"></p>
</section>

<section class="panel">
    <div class="section-title"><h2>요약</h2></div>
    <div id="summary"><p class="empty">가게를 불러오는 중입니다.</p></div>
</section>

<section class="panel">
    <div class="section-title"><h2>정산 내역</h2></div>
    <div id="list"></div>
    <div id="pager"></div>
</section>

<script>
    (() => {
        const pageFetch = (path, options = {}) => fetch(path, Object.assign({credentials: 'same-origin'}, options));
        const $ = id => document.getElementById(id);
        const money = value => Number(value || 0).toLocaleString('ko-KR') + '원';
        const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        }[c]));
        const TYPES = {
            PURCHASE_FEE: '구매 대금',
            AUCTION_SALE: '경매 낙찰 대금',
            EXCHANGE_FEE: '교환 수수료',
            EVENT_FEE: '이벤트 참가비',
            NO_SHOW_FEE: '교환 노쇼 몰수금',
            AUCTION_DEPOSIT_FORFEIT: '경매 보증금 몰수'
        };
        let page = 0;

        const showMessage = (text, error = false) => {
            $('message').textContent = text || '';
            $('message').className = error ? 'error' : 'empty';
        };

        // 조회 조건을 쿼리 문자열로 만든다
        const query = (extra = '') => {
            const params = new URLSearchParams();
            if ($('type').value) params.set('type', $('type').value);
            if ($('from').value) params.set('from', $('from').value);
            if ($('to').value) params.set('to', $('to').value);
            return '?' + params.toString() + extra;
        };

        // 내 가게 목록 (로그인한 사장님의 가게를 자동으로 불러온다)
        async function loadShops() {
            const response = await pageFetch('/api/shops/me?size=50');
            if (!response.ok) return showMessage('가게 목록을 불러오지 못했습니다. 로그인을 확인하세요.', true);
            const shops = (await response.json()).content || [];
            $('shop').innerHTML = shops.map(shop => `<option value="${shop.id}">${escapeHtml(shop.name)}</option>`).join('');
            if (!shops.length) {
                $('summary').innerHTML = '<p class="empty">운영 중인 가게가 없습니다.</p>';
                return;
            }
            await load(0);
        }

        // 요약과 목록을 불러온다
        async function load(nextPage) {
            const shopId = $('shop').value;
            if (!shopId) return;
            page = nextPage;
            showMessage('');
            const [summaryRes, listRes] = await Promise.all([
                pageFetch('/api/shops/' + shopId + '/settlements/summary' + query()),
                pageFetch('/api/shops/' + shopId + '/settlements' + query('&page=' + page + '&size=20'))
            ]);
            if (!summaryRes.ok || !listRes.ok) return showMessage('정산 내역을 불러오지 못했습니다.', true);
            renderSummary(await summaryRes.json());
            renderList(await listRes.json());
        }

        function renderSummary(s) {
            $('summary').innerHTML =
                `<div class="payment-row"><div><strong>총매출</strong></div><span>${money(s.grossRevenue)}</span></div>`
                + `<div class="payment-row"><div><strong>구독료 지출</strong></div><span>${money(s.subscriptionExpense)}</span></div>`
                + `<div class="payment-row"><div><strong>순매출</strong></div><span>${money(s.netRevenue)}</span></div>`
                + (s.byType || []).map(t =>
                    `<div class="payment-row"><div><small>${escapeHtml(TYPES[t.type] || t.type)} · ${t.count}건</small></div><span>${money(t.totalAmount)}</span></div>`
                ).join('');
        }

        function renderList(data) {
            const rows = data.content || [];
            $('list').innerHTML = rows.length ? rows.map(r =>
                `<div class="payment-row"><div><strong>${escapeHtml(TYPES[r.type] || r.type)}</strong>`
                + `<small>${escapeHtml(r.paymentId)} · ${escapeHtml((r.createdAt || '').replace('T', ' ').slice(0, 16))}</small></div>`
                + `<span>${money(r.amount)}</span></div>`
            ).join('') : '<p class="empty">조건에 맞는 정산 내역이 없습니다.</p>';
            $('pager').innerHTML = data.totalPages > 1
                ? `<button type="button" id="prev" ${data.first ? 'disabled' : ''}>이전</button> ${data.number + 1} / ${data.totalPages} `
                + `<button type="button" id="next" ${data.last ? 'disabled' : ''}>다음</button>` : '';
            if ($('prev')) $('prev').addEventListener('click', () => load(page - 1));
            if ($('next')) $('next').addEventListener('click', () => load(page + 1));
        }

        // 유형 선택지를 채운다
        $('type').innerHTML += Object.entries(TYPES).map(([key, label]) => `<option value="${key}">${label}</option>`).join('');
        $('reload').addEventListener('click', () => load(0));
        $('shop').addEventListener('change', () => load(0));
        loadShops();
    })();
</script>
{{> fragments/footer}}
