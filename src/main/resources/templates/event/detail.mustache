{{> fragments/header}}
<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>

<style>
/* 상품 상세(item/detail)와 같은 정보 영역 스타일 — 사진/정보를 같은 높이(450px)로 맞춰 한 화면에 보이게 */
.container.item-detail { margin-top: 1.5rem; }
.item-detail .detail-image { aspect-ratio: auto; height: 450px; }
.item-detail-info { height: 450px; display: flex; flex-direction: column; }
@media (max-width: 760px) { .item-detail .detail-image, .item-detail-info { height: auto; } .item-detail .detail-image { aspect-ratio: 3 / 4; } }
.item-detail-info .item-tag { font-size: 0.78rem; color: var(--color-muted); margin: 0 0 0.4rem; }
.item-detail-info h1 { flex: none; margin: 0 0 0.5rem; font-size: 1.35rem; line-height: 1.35; } /* 공통 .detail-title 의 flex:1 을 끄고 설명이 제목 바로 아래 붙게 */
.ev-desc { margin: 0.9rem 0 0; font-size: 0.86rem; line-height: 1.7; color: var(--color-text-soft, #444); white-space: pre-line; }
.ev-summary { flex: 1; min-height: 0; overflow-y: auto; margin: 0.2rem 0 0.8rem; font-size: 0.9rem; line-height: 1.7; color: var(--color-text-soft, #444); white-space: pre-line; }
/* 이벤트임을 한눈에: 상단 이벤트 라벨 + 참가비/현장 결제 분리 + 강조색 박스 */
.ev-head { display: flex; gap: 0.4rem; align-items: center; margin-bottom: 0.6rem; }
.ev-price { display: flex; gap: 1.5rem; margin: 0.2rem 0 0.3rem; }
.ev-price small { display: block; font-size: 0.75rem; color: var(--color-muted); }
.ev-price b { font-size: 1.3rem; color: var(--color-text); }
.ev-price span { font-size: 1.05rem; font-weight: 600; }
.ev-visit { margin: 0 0 0.8rem; font-size: 0.95rem; font-weight: 500; color: var(--color-text); }
.ev-visit span { margin-right: 0.6rem; font-size: 0.78rem; font-weight: 500; color: var(--color-muted); }
.ev-price-note { margin: 0 0 0.8rem; font-size: 0.76rem; color: var(--color-muted); }
.ev-box { margin: auto 0 0.8rem; padding: 0.6rem 0.9rem; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); font-size: 0.82rem; color: var(--color-muted); }
.ev-box .ev-stats { display: flex; justify-content: space-between; gap: 0.8rem; white-space: nowrap; }
.ev-box .ev-row { display: flex; gap: 0.4rem; align-items: baseline; }
.ev-box .ev-row strong { font-size: 0.92rem; font-weight: 600; color: var(--color-text); font-variant-numeric: tabular-nums; }
.ev-box .ev-row strong.is-soon { color: #C0392B; }
.ev-gauge { height: 4px; margin: 0.45rem 0 0; border-radius: 999px; background: var(--color-border); overflow: hidden; }
.ev-gauge span { display: block; height: 100%; background: var(--color-dark); border-radius: 999px; }
#ev-action, #ev-pay { width: 100%; }
.ev-mylink { display: block; box-sizing: border-box; width: 100%; margin-top: 0.4rem; padding: 0.7rem 1rem; text-align: center; font-size: 0.9rem; color: var(--color-text); background: transparent; border: 1px solid var(--color-border); border-radius: 8px; text-decoration: none; }
.ev-mylink[hidden] { display: none; } /* display:block 이 hidden 속성을 덮어쓰지 않게 */
.ev-mylink:hover { border-color: var(--color-muted); text-decoration: none; }
#ev-action:disabled, #ev-pay:disabled { opacity: 0.45; cursor: not-allowed; }

/* 참가/결제 창 (상품 상세의 주문/결제 창과 같은 디자인) */
.modal-card.order-modal { max-width: 520px; padding: 0; max-height: 90vh; overflow-y: auto; }
.order-modal h1 { margin: 0; padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--color-border); font-size: 1.05rem; text-align: center; }
.order-modal .modal-close { top: 1rem; }
.order-section { padding: 1.2rem 1.5rem; border-bottom: 8px solid var(--color-surface); }
.order-section h2 { margin: 0 0 0.9rem; font-size: 0.98rem; }
.order-item { display: flex; gap: 0.9rem; align-items: center; }
.order-item-thumb { flex: none; width: 72px; height: 72px; border-radius: 8px; overflow: hidden; background: #fff; border: 1px solid var(--color-border); box-sizing: border-box; }
.order-item-thumb img { width: 100%; height: 100%; object-fit: contain; }
.order-item small { display: block; font-size: 0.76rem; color: var(--color-muted); }
.order-item strong { display: block; margin-top: 0.15rem; font-size: 0.92rem; font-weight: 500; }
.order-qty { display: flex; justify-content: space-between; align-items: center; margin-top: 0.9rem; padding: 0.7rem 1rem; border-radius: 8px; background: var(--color-surface); font-size: 0.84rem; }
.order-qty small { display: block; color: var(--color-muted); font-size: 0.74rem; }
.qty-step { display: flex; align-items: center; border: 1px solid var(--color-border); border-radius: 8px; background: #fff; overflow: hidden; }
.qty-step button { width: 34px; height: 34px; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--color-text); font-size: 1.05rem; }
.qty-step button:disabled { opacity: 0.3; cursor: not-allowed; }
.qty-step b { min-width: 36px; text-align: center; font-variant-numeric: tabular-nums; }
.ev-guide { margin: 0; padding-left: 1.1rem; font-size: 0.82rem; line-height: 1.75; color: var(--color-text-soft); }
.ev-guide b { color: var(--color-text); }
.ev-guide .ev-guide-date { display: inline-block; padding: 0 0.4rem; margin: 0 0.1rem; line-height: 1.45; border-radius: 4px; background: var(--color-dark); color: #fff; font-weight: 600; white-space: nowrap; }
.order-pay { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }
.order-pay input { width: auto; margin: 0; accent-color: var(--color-dark); }
.order-sum div { display: flex; justify-content: space-between; margin-bottom: 0.45rem; font-size: 0.86rem; color: var(--color-muted); }
.order-sum div[hidden] { display: none; }
.order-sum div.total { margin: 0.7rem 0 0; padding-top: 0.7rem; border-top: 1px solid var(--color-border); color: var(--color-text); font-weight: 600; }
.order-sum div.total b { font-size: 1.15rem; }
.ev-agree { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.84rem; line-height: 1.5; cursor: pointer; }
.ev-agree input { width: auto; margin: 0.2rem 0 0; accent-color: var(--color-dark); }
.order-submit { padding: 1rem 1.5rem 1.4rem; }
</style>

<div class="container detail-container item-detail">
<a href="/test/event" class="back-link">← 목록으로</a>
<div class="detail-grid">
    <div class="detail-media">
        <div class="detail-image image-contain">
            {{#event.itemImageUrl}}<img src="{{event.itemImageUrl}}" alt="{{event.itemTitle}}">{{/event.itemImageUrl}}
            {{^event.itemImageUrl}}이미지 없음{{/event.itemImageUrl}}
        </div>
    </div>
    <!-- 상세는 간단하게: 가격/남은 수량/마감만. 참가 방법·동의·수량 선택은 참가하기 → 결제 창에서 -->
    <div class="detail-info item-detail-info">
        <div class="ev-head">
            <span class="badge">선착순 이벤트</span>
            <span class="badge" id="ev-status"></span>
        </div>
        <p class="item-tag">{{event.shopName}} · {{event.shopAddress}}</p>
        <h1 class="detail-title">{{event.itemTitle}}</h1>
        <!-- 제목 아래 빈 공간에 상품 설명 (길면 이 칸 안에서 스크롤) -->
        <p class="ev-summary">{{event.itemDescription}}</p>
        <div class="ev-price">
            <div><small>참가비 (지금 결제)</small><b id="ev-fee"></b></div>
            <div><small>현장 결제 (매장에서)</small><span id="ev-onsite"></span></div>
        </div>
        <p class="ev-price-note" id="ev-price-note"></p>
        <p class="ev-visit"><span>매장 방문 날짜</span><b id="ev-visit-date"></b></p>

        <!-- 상품 설명은 상세가 아니라 참가/결제 창에서 보여준다 -->
        <div class="ev-box">
            <div class="ev-stats">
                <div class="ev-row"><span>남은 수량</span><strong id="ev-seats"></strong></div>
                <div class="ev-row"><span>마감까지</span><strong id="ev-left"></strong></div>
            </div>
            <div class="ev-gauge"><span id="ev-gauge"></span></div>
        </div>

        <button type="button" id="ev-action">참가하기</button>
        <!-- 참가한 뒤에는 번호표 확인과 구매 취소를 마이페이지 이벤트 내역에서 한다 -->
        <a href="/my/events" class="ev-mylink" id="ev-mylink" hidden>내 참가 내역 · 취소하러 가기</a>
    </div>
</div>
</div>

<!-- 참가/결제 창 -->
<div class="modal-backdrop" id="ev-modal" hidden>
<div class="modal-card order-modal">
    <button type="button" class="modal-close" id="ev-close">✕</button>
    <h1 id="ev-modal-title">이벤트 참가/결제</h1>

    <section class="order-section">
        <h2>이벤트 상품</h2>
        <div class="order-item">
            <div class="order-item-thumb">{{#event.itemImageUrl}}<img src="{{event.itemImageUrl}}" alt="">{{/event.itemImageUrl}}</div>
            <div><small>{{event.shopName}}</small><strong>{{event.itemTitle}}</strong></div>
        </div>
        {{#event.itemDescription}}<p class="ev-desc">{{event.itemDescription}}</p>{{/event.itemDescription}}
        <div class="order-qty">
            <div>수량 선택<small id="ev-qty-hint"></small></div>
            <div class="qty-step">
                <button type="button" id="ev-qty-minus" aria-label="수량 줄이기">−</button>
                <b id="ev-qty">1</b>
                <button type="button" id="ev-qty-plus" aria-label="수량 늘리기">+</button>
            </div>
        </div>
    </section>

    <section class="order-section">
        <h2>참가 안내</h2>
        <ol class="ev-guide">
            <li>상품 1개 가격은 <b id="g-price"></b>이에요. 이 중 참가비 <b id="g-fee"></b>을 지금 결제하고, 나머지 <b id="g-onsite"></b>은 매장에서 결제해요.</li>
            <li>결제하면 번호표가 발급돼요. 번호표 번호는 선착순으로 정해지고, 구매한 수량도 함께 적혀요. 준비된 수량이 모두 팔리면 바로 마감돼요.</li>
            <li>더 사고 싶다면 <b>추가 구매</b>를 할 수 있어요. 한 사람당 최대 구매 수량까지 살 수 있고, 추가로 산 수량도 내 번호표 하나에 함께 담겨요.</li>
            <li><b class="ev-guide-date" id="g-visit"></b>에 번호표를 가지고 <b>{{event.shopName}}</b>({{event.shopAddress}})으로 방문해 주세요. 번호표 순서대로 매장에서 나머지 금액을 결제하고 상품을 받을 수 있어요.</li>
            <li>모집이 마감되기 전에는 구매한 내역별로 참가를 취소하고 참가비를 환불받을 수 있어요. 가게 사정으로 이벤트가 취소되면 참가비는 전액 환불돼요.</li>
            <li><b>모집이 마감된 뒤에는 참가비가 환불되지 않아요.</b> (매장에 방문하지 않은 경우도 같아요)</li>
        </ol>
    </section>

    <section class="order-section">
        <h2>결제수단</h2>
        <label class="order-pay"><input type="radio" name="ev-pay-method" checked> 신용/체크카드</label>
    </section>

    <section class="order-section order-sum">
        <h2>결제금액</h2>
        <div><span id="s-fee-label"></span><span id="s-fee"></span></div>
        <div id="s-total-row" hidden><span id="s-total-label"></span><span id="s-total-qty"></span></div>
        <div><span id="s-onsite-label">매장에서 결제할 금액 (현장)</span><span id="s-onsite"></span></div>
        <div class="total"><span>지금 결제할 금액</span><b id="s-total"></b></div>
    </section>

    <section class="order-section">
        <label class="ev-agree"><input type="checkbox" id="ev-agree"> 위 참가 안내를 확인했으며, 모집 마감 후에는 참가비가 환불되지 않는 것에 동의합니다. (필수)</label>
    </section>

    <div class="order-submit">
        <button type="button" id="ev-pay" disabled></button>
    </div>
</div>
</div>

<script>
(() => {
    const pageFetch = (path, options = {}) => fetch(path, Object.assign({ credentials: 'same-origin' }, options));
    const errorText = async (res, fallback) => {
        const text = await res.text();
        try { return JSON.parse(text).message || fallback; } catch (e) { return text || fallback; }
    };
    const money = v => Number(v || 0).toLocaleString('ko-KR') + '원';
    const $ = id => document.getElementById(id);
    const portoneStoreId = '{{portoneStoreId}}';
    const portoneChannelKey = '{{portoneChannelKey}}';
    const userId = {{#userId}}{{userId}}{{/userId}}{{^userId}}null{{/userId}};
    const shopAccount = {{shopAccount}}; // 가게 계정은 어떤 이벤트에도 참가할 수 없다 (서버에서도 거절)
    const ownEvent = {{ownEvent}}; // 내 가게 이벤트면 참가 버튼을 막는다 (서버에서도 거절)
    // TODO(데모 종료 후 제거): 데모 모드면 결제창 없이 참가 (데모 바의 결제 O/X 토글을 따른다)
    const skipPayment = () => '{{skipPayment}}' === 'true' && window.gbPaySkip && window.gbPaySkip();
    const VISIT_DATE = '{{event.visitUntil}}'.replaceAll('-', '.');   // 손님이 매장에 오는 마지막 날 (예: 2026.11.26)
    const MAX_QTY = {{event.maxPerUser}}; // 가게가 정한 1인당 최대 구매 수량
    const ev = {
        id: {{event.id}}, title: document.querySelector('.detail-title').textContent,
        price: {{event.itemPrice}}, fee: {{event.feeAmount}},
        capacity: {{event.capacity}}, count: {{event.currentCount}},
        status: '{{event.status}}', deadline: new Date('{{event.deadline}}'.slice(0, 19))
    };
    // 상품 가격(정가) = 참가비(지금) + 현장 결제(매장)
    const onsite = Math.max(0, ev.price - ev.fee);

    const actionBtn = $('ev-action');
    const leftEl = $('ev-left');
    let mine = [];   // 이 이벤트에서 내가 참가중인 구매 건들 (같은 번호표에 추가 구매가 쌓인다)
    let qty = 1;

    $('ev-fee').textContent = money(ev.fee);
    $('ev-onsite').textContent = money(onsite);
    $('ev-price-note').textContent = `상품 가격 ${money(ev.price)} 중 참가비 ${money(ev.fee)}을 먼저 내고, 매장에서 ${money(onsite)}만 내면 돼요.`;
    $('ev-visit-date').textContent = VISIT_DATE;
    $('g-visit').textContent = VISIT_DATE;
    $('g-price').textContent = money(ev.price);
    $('g-fee').textContent = money(ev.fee);
    $('g-onsite').textContent = money(onsite);

    // 마감시간이 지났으면 상태가 OPEN 이어도(스케줄러 반영 전) 마감으로 본다
    const isOpen = () => ev.status === 'OPEN' && ev.deadline > new Date();
    const remaining = () => Math.max(0, ev.capacity - ev.count);
    const isFull = () => remaining() === 0;
    const statusLabel = () => ev.status === 'CANCELLED' ? '취소됨' : !isOpen() ? '마감' : isFull() ? '수량 마감' : '모집중';
    const ticketText = p => `#${p.ticketNumber} · ${p.quantity}개`;
    const myTotal = () => mine.reduce((sum, p) => sum + p.quantity, 0);   // 내가 산 수량 합계
    const myTicket = () => mine.length ? mine[0].ticketNumber : null;
    const canBuyMore = () => Math.max(0, MAX_QTY - myTotal());              // 1인 최대 수량까지 더 살 수 있는 수량

    function tick() {
        if (ev.status === 'CANCELLED') { leftEl.textContent = '가게 사정으로 취소됐어요'; return; }
        const ms = ev.deadline - new Date();
        if (ms <= 0) { leftEl.textContent = '마감되었어요'; leftEl.classList.remove('is-soon'); return; }
        const s = Math.floor(ms / 1000), d = Math.floor(s / 86400);
        const pad = n => String(n).padStart(2, '0');
        leftEl.textContent = `${d ? d + '일 ' : ''}${pad(Math.floor(s % 86400 / 3600))}:${pad(Math.floor(s % 3600 / 60))}:${pad(s % 60)}`;
        leftEl.classList.toggle('is-soon', ms < 3600 * 1000);
    }

    function render() {
        $('ev-status').textContent = statusLabel();
        $('ev-seats').textContent = `${remaining()} / ${ev.capacity}개`;
        $('ev-gauge').style.width = Math.min(100, Math.round(ev.count / ev.capacity * 100)) + '%';
        // 참가 전엔 '참가하기', 참가 후엔 '추가 구매' 버튼만 보인다 (번호표/참가 내역/취소는 마이페이지 > 이벤트 내역)
        const joined = mine.length > 0;
        $('ev-mylink').hidden = !joined;
        const more = Math.min(canBuyMore(), remaining());
        actionBtn.disabled = shopAccount || ownEvent || !(isOpen() && !isFull()) || (joined && more === 0);
        actionBtn.textContent = shopAccount ? '가게 계정은 참가할 수 없어요'
            : ownEvent ? '내 가게 이벤트라 참가할 수 없어요'
            : !(isOpen() && !isFull()) ? statusLabel()
            : joined ? (more === 0 ? '최대 수량까지 구매했어요' : `추가 구매 (${more}개 더 가능)`)
            : '참가하기';
        tick();
    }

    // ===== 참가/결제 창 =====
    const modal = $('ev-modal');
    const maxQty = () => Math.max(1, Math.min(canBuyMore(), remaining()));
    function renderModal() {
        const extra = mine.length > 0;   // 추가 구매 중인지
        $('ev-modal-title').textContent = extra ? '이벤트 추가 구매/결제' : '이벤트 참가/결제';
        qty = Math.min(Math.max(1, qty), maxQty());
        $('ev-qty').textContent = qty;
        $('ev-qty-minus').disabled = qty <= 1;
        $('ev-qty-plus').disabled = qty >= maxQty();
        $('ev-qty-hint').textContent = extra
            ? `이미 ${myTotal()}개 구매했어요 · 추가로 최대 ${canBuyMore()}개 (남은 수량 ${remaining()}개)`
            : MAX_QTY === 1 ? '1인 1개 한정' : `1인 최대 ${MAX_QTY}개 · 남은 수량 ${remaining()}개`;
        $('s-fee-label').textContent = `${extra ? '추가 구매 ' : ''}참가비 ${money(ev.fee)} × ${qty}개`;
        $('s-fee').textContent = money(ev.fee * qty);
        // 추가 구매면 번호표 전체(기존 + 추가) 수량과 현장 결제 금액을 같이 안내
        const totalQty = myTotal() + qty;
        $('s-total-row').hidden = !extra;
        $('s-total-label').textContent = `내 번호표 총 구매 수량 (지금까지 ${myTotal()}개 + 이번 ${qty}개)`;
        $('s-total-qty').textContent = `${totalQty}개`;
        $('s-onsite-label').textContent = extra ? `매장에서 낼 금액 (총 ${totalQty}개 기준)` : '매장에서 결제할 금액 (현장)';
        $('s-onsite').textContent = money(onsite * totalQty);
        $('s-total').textContent = money(ev.fee * qty);
        $('ev-pay').textContent = `${money(ev.fee * qty)} ${extra ? '추가 ' : ''}결제하기`;
        $('ev-pay').disabled = !$('ev-agree').checked;
    }
    $('ev-qty-minus').addEventListener('click', () => { qty--; renderModal(); });
    $('ev-qty-plus').addEventListener('click', () => { qty++; renderModal(); });
    $('ev-agree').addEventListener('change', renderModal);
    $('ev-close').addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', e => { if (e.target === modal) modal.hidden = true; });

    async function loadMine() {
        if (userId === null) return;
        const res = await pageFetch('/api/events/me');
        if (res.ok) mine = (await res.json()).filter(p => p.shopEventId === ev.id && p.status === 'JOINED');
    }

    async function refresh() {
        const res = await pageFetch('/api/events/' + ev.id);
        if (res.ok) {
            const e = await res.json();
            ev.count = e.currentCount; ev.status = e.status;
        }
        await loadMine();
        render();
    }

    async function pay(amount) {
        if (skipPayment()) return { paymentId: `demo-pay-${crypto.randomUUID()}` };
        if (!window.PortOne) throw new Error('포트원 SDK를 불러오지 못했습니다.');
        const result = await PortOne.requestPayment({
            storeId: portoneStoreId, channelKey: portoneChannelKey,
            paymentId: `goodsbridge-event-${crypto.randomUUID()}`,
            orderName: `${ev.title} 이벤트 참가비 ${qty}개`, totalAmount: amount, currency: 'KRW', payMethod: 'CARD'
        });
        if (result.code) throw new Error(result.message || '결제가 취소되었습니다.');
        return result;
    }

    actionBtn.addEventListener('click', async () => {
        if (userId === null) {
            await alert('로그인이 필요합니다.');
            const loginBtn = $('nav-login');
            if (loginBtn) loginBtn.click();
            return;
        }
        qty = 1;
        $('ev-agree').checked = false;
        renderModal();
        modal.hidden = false;
    });

    $('ev-pay').addEventListener('click', async () => {
        const payBtn = $('ev-pay');
        payBtn.disabled = true;
        try {
            const result = await pay(ev.fee * qty);
            const res = await pageFetch(`/api/events/${ev.id}/join`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentId: result.paymentId, quantity: qty })
            });
            // 서버가 거절하면(수량 마감 등) 결제는 서버에서 자동 취소된다
            if (!res.ok) throw new Error(await errorText(res, '참가에 실패했습니다.') + '\n결제한 금액은 자동으로 취소돼요.');
            const joined = await res.json();
            modal.hidden = true;
            await alert(mine.length > 0
                ? `추가 구매 완료! 번호표 #${joined.ticketNumber}에 ${joined.quantity}개가 더해졌어요. (총 ${myTotal() + joined.quantity}개)`
                : `참가 완료! 번호표 ${ticketText(joined)} 가 발급되었어요.\n마이페이지 > 이벤트 내역에서 확인할 수 있어요.`);
        } catch (err) {
            await alert(err.message);
        } finally {
            await refresh();
            renderModal();
        }
    });

    setInterval(tick, 1000);
    loadMine().then(render);
    // 마이페이지에서 취소하고 뒤로 왔을 때(캐시된 화면)도 최신 참가 상태로 다시 그린다
    window.addEventListener('pageshow', e => { if (e.persisted) refresh(); });
})();
</script>

