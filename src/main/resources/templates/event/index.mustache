{{> fragments/header}}

<style>
/* 카드 정보는 한 줄로 (넘치면 말줄임) */
/* 정렬 메뉴는 글자가 두 줄로 꺾이지 않게 메뉴 폭을 내용에 맞춘다 */
#sort-menu { min-width: 100%; width: max-content; left: auto; right: 0; }
#sort-menu .scope-menu-item { white-space: nowrap; }
.ev-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
</style>

<h1 class="page-title">선착순 이벤트</h1>
<p id="shop-filter-info" class="card-meta shop-filter-info" hidden></p>

<div class="list-toolbar">
    <span class="list-toolbar-category" id="toolbar-label">모집중</span>
    <div class="list-toolbar-actions">
        <div class="scope-dropdown" id="scope-dropdown">
            <button type="button" class="write-link" id="scope-trigger">모집중</button>
            <div class="scope-menu" id="scope-menu" hidden>
                <button type="button" class="scope-menu-item active" data-tab="OPEN">모집중</button>
                <button type="button" class="scope-menu-item" data-tab="MINE">내 참가</button>
                <button type="button" class="scope-menu-item" data-tab="ENDED">마감·취소</button>
            </div>
        </div>
        <div class="scope-dropdown" id="sort-dropdown">
            <button type="button" class="write-link" id="sort-trigger">마감 임박순</button>
            <div class="scope-menu" id="sort-menu" hidden>
                <button type="button" class="scope-menu-item active" data-sort="DEADLINE">마감 임박순</button>
                <button type="button" class="scope-menu-item" data-sort="NEWEST">최근 등록순</button>
                <button type="button" class="scope-menu-item" data-sort="FEE">참가비 낮은순</button>
                <button type="button" class="scope-menu-item" data-sort="LEFT">남은 수량 적은순</button>
            </div>
        </div>
        <label for="keyword-input" class="sr-only">검색</label>
        <input type="text" id="keyword-input" class="toolbar-search" placeholder="상품명 · 가게 검색" autocomplete="off">
    </div>
</div>

<div class="card-grid" id="item-grid"></div>
<p class="empty-state" id="empty-state">이벤트를 불러오는 중...</p>

<script>
(() => {
    const pageFetch = (path, options = {}) => fetch(path, Object.assign({ credentials: 'same-origin' }, options));
    const money = v => Number(v || 0).toLocaleString('ko-KR') + '원';
    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const userId = {{#userId}}{{userId}}{{/userId}}{{^userId}}null{{/userId}};

    const grid = document.getElementById('item-grid');
    const emptyEl = document.getElementById('empty-state');
    const keywordInput = document.getElementById('keyword-input');
    const TAB_LABELS = { OPEN: '모집중', MINE: '내 참가', ENDED: '마감·취소' };
    let events = [];
    let mine = {};      // shopEventId -> 내 참가 (JOINED)
    let tab = 'OPEN';
    let sortKey = 'DEADLINE';
    const SORT_LABELS = { DEADLINE: '마감 임박순', NEWEST: '최근 등록순', FEE: '참가비 낮은순', LEFT: '남은 수량 적은순' };

    // 마감시간이 지났으면 상태가 OPEN 이어도(스케줄러 반영 전) 마감으로 본다
    const deadlineOf = e => new Date(e.deadline);
    const isOpen = e => e.status === 'OPEN' && deadlineOf(e) > new Date();
    const statusLabel = e => e.status === 'CANCELLED' ? '취소' : !isOpen(e) ? '마감' : e.currentCount >= e.capacity ? '수량 마감' : '모집중';

    // 남은 시간: 하루 이상이면 D-n, 하루 안이면 시:분:초
    function leftText(e) {
        if (e.status === 'CANCELLED') return '취소됨';
        const ms = deadlineOf(e) - new Date();
        if (ms <= 0) return '마감';
        const s = Math.floor(ms / 1000), d = Math.floor(s / 86400);
        if (d > 0) return `D-${d}`;
        const pad = n => String(n).padStart(2, '0');
        return `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s % 3600 / 60))}:${pad(s % 60)}`;
    }

    // 헤더의 '전체 매장' 선택을 교환 게시판처럼 따른다
    const selectedShopId = () => { try { return localStorage.getItem('gb_shop_id') || ''; } catch (e) { return ''; } };

    // 마감 임박순은 불러올 때의 기본 순서(모집중은 마감 임박 순, 나머지는 최근 마감 순)를 그대로 쓴다
    function sortList(list) {
        const left = e => Math.max(0, e.capacity - e.currentCount);
        const by = { NEWEST: (a, b) => new Date(b.createdAt) - new Date(a.createdAt) || b.id - a.id,
                     FEE: (a, b) => a.feeAmount - b.feeAmount || deadlineOf(a) - deadlineOf(b),
                     LEFT: (a, b) => left(a) - left(b) || deadlineOf(a) - deadlineOf(b) }[sortKey];
        return by ? [...list].sort(by) : list;
    }

    function rows() {
        const kw = keywordInput.value.trim().toLowerCase();
        const shopId = selectedShopId();
        return sortList(events).filter(e => tab === 'MINE' ? mine[e.id] : tab === 'ENDED' ? !isOpen(e) : isOpen(e))
            .filter(e => !shopId || String(e.shopId) === shopId)
            .filter(e => !kw || (e.itemTitle + ' ' + e.shopName).toLowerCase().includes(kw));
    }

    function render() {
        const list = rows();
        grid.innerHTML = list.map(e => `
            <a class="card" href="/test/event/${e.id}">
                <span class="card-tag">■ ${statusLabel(e)}${mine[e.id] ? ` · 번호표 #${mine[e.id].ticketNumber} · ${mine[e.id].quantity}개` : ''}</span>
                <div class="card-image image-contain">${e.itemImageUrl ? `<img src="${esc(e.itemImageUrl)}" alt="${esc(e.itemTitle)}">` : '이미지 없음'}</div>
                <p class="card-title">${esc(e.itemTitle)}</p>
                <p class="card-price">${money(e.itemPrice)}</p>
                <p class="card-meta ev-line">참가비 ${money(e.feeAmount)} · 남은 ${Math.max(0, e.capacity - e.currentCount)}개 · <span data-left="${e.id}">${leftText(e)}</span></p>
                <p class="card-meta ev-line">${esc(e.shopName)}</p>
            </a>`).join('');
        const msg = { OPEN: '지금 모집 중인 이벤트가 없어요.', MINE: userId === null ? '로그인하면 참가한 이벤트를 볼 수 있어요.' : '참가한 이벤트가 없어요.', ENDED: '마감되거나 취소된 이벤트가 없어요.' }[tab];
        emptyEl.textContent = keywordInput.value.trim() ? '검색 결과가 없어요.' : msg;
        emptyEl.hidden = list.length > 0;
    }

    async function load() {
        try {
            const res = await pageFetch('/api/events');
            if (!res.ok) throw new Error('이벤트를 불러오지 못했어요.');
            // 모집중은 마감 임박 순, 나머지는 최근 마감 순
            events = (await res.json()).sort((a, b) => isOpen(b) - isOpen(a)
                || (isOpen(a) ? deadlineOf(a) - deadlineOf(b) : deadlineOf(b) - deadlineOf(a)));
            if (userId !== null) {
                const meRes = await pageFetch('/api/events/me');
                if (meRes.ok) (await meRes.json()).filter(p => p.status === 'JOINED').forEach(p => {
                    // 추가 구매는 같은 번호표에 구매 건이 여러 개라, 수량은 합산해서 보여준다
                    const prev = mine[p.shopEventId];
                    mine[p.shopEventId] = prev ? { ...prev, quantity: prev.quantity + p.quantity } : { ticketNumber: p.ticketNumber, quantity: p.quantity };
                });
            }
            render();
        } catch (e) {
            emptyEl.textContent = e.message;
            emptyEl.hidden = false;
        }
    }

    // 남은 시간만 1초마다 갱신
    setInterval(() => {
        document.querySelectorAll('[data-left]').forEach(el => {
            const e = events.find(x => x.id === Number(el.dataset.left));
            if (e) el.textContent = leftText(e);
        });
    }, 1000);

    // 상태 선택 (교환 게시판의 검색 범위 드롭다운과 같은 모양)
    const scopeTrigger = document.getElementById('scope-trigger');
    const scopeMenu = document.getElementById('scope-menu');
    document.getElementById('scope-dropdown').addEventListener('click', ev => {
        ev.stopPropagation();
        document.getElementById('sort-menu').hidden = true;
        if (ev.target === scopeTrigger) { scopeMenu.hidden = !scopeMenu.hidden; return; }
        const item = ev.target.closest('.scope-menu-item');
        if (!item) return;
        tab = item.dataset.tab;
        scopeTrigger.textContent = TAB_LABELS[tab];
        document.getElementById('toolbar-label').textContent = TAB_LABELS[tab];
        scopeMenu.querySelectorAll('.scope-menu-item').forEach(el => el.classList.toggle('active', el === item));
        scopeMenu.hidden = true;
        render();
    });
    // 정렬 선택 (상태 선택과 같은 모양의 드롭다운)
    const sortTrigger = document.getElementById('sort-trigger');
    const sortMenu = document.getElementById('sort-menu');
    document.getElementById('sort-dropdown').addEventListener('click', ev => {
        ev.stopPropagation();
        scopeMenu.hidden = true;
        if (ev.target === sortTrigger) { sortMenu.hidden = !sortMenu.hidden; return; }
        const item = ev.target.closest('.scope-menu-item');
        if (!item) return;
        sortKey = item.dataset.sort;
        sortTrigger.textContent = SORT_LABELS[sortKey];
        sortMenu.querySelectorAll('.scope-menu-item').forEach(el => el.classList.toggle('active', el === item));
        sortMenu.hidden = true;
        render();
    });
    document.addEventListener('click', () => { scopeMenu.hidden = true; sortMenu.hidden = true; });
    keywordInput.addEventListener('input', render);
    // 헤더에서 매장을 고르면 교환 게시판처럼 안내 문구를 보여준다
    const shopInfo = document.getElementById('shop-filter-info');
    function updateShopInfo() {
        const shopId = selectedShopId();
        if (!shopId) { shopInfo.hidden = true; return; }
        pageFetch('/api/shops/' + shopId).then(res => res.ok ? res.json() : null).then(shop => {
            if (!shop) { shopInfo.hidden = true; return; }
            shopInfo.textContent = `${shop.name} · ${shop.region || ''} 매장 이벤트만 보고 있습니다.`;
            shopInfo.hidden = false;
        });
    }
    window.addEventListener('gb-shop-changed', () => { updateShopInfo(); render(); });
    updateShopInfo();

    load();
})();
</script>

{{> fragments/footer}}
