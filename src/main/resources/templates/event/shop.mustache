{{> fragments/header}}

<style>
.se-bar { display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; margin-bottom: 0.9rem; flex-wrap: wrap; }
.se-bar .filter-chip-grid { margin: 0; }
.se-bar .filter-chip small { margin-left: 0.3rem; opacity: 0.7; }
.se-bar .write-link { flex: none; width: auto; white-space: nowrap; }
.se-panel { border: 1px solid var(--color-border); border-radius: 14px; background: #fff; padding: 0.4rem 1rem; }
.se-row { display: flex; align-items: center; gap: 0.9rem; padding: 0.9rem 0; border-bottom: 1px solid var(--color-border); }
.se-row:last-child { border-bottom: 0; }
.se-row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
.se-row-main strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.se-row-main small { color: var(--color-muted); font-size: 0.8rem; }
.se-actions { flex: none; display: flex; align-items: center; gap: 0.4rem; }
.se-actions button { padding: 0.35rem 0.75rem; font-size: 0.8rem; background: transparent; color: var(--color-text); border: 1px solid var(--color-border); border-radius: 999px; }
.se-actions button:hover { border-color: var(--color-muted); }
.se-badge { flex: none; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.72rem; background: var(--color-surface); color: var(--color-muted); white-space: nowrap; }
.se-badge.is-ok { background: #EAF5EE; color: #2E7D4F; }
.se-badge.is-warn { background: #FDECEA; color: #C0392B; }
.se-empty { padding: 4rem 0; text-align: center; color: var(--color-muted); font-size: 0.86rem; }
.se-section { margin: 0.9rem 0 0.4rem; font-size: 0.82rem; color: var(--color-muted); }
.se-form-row { display: flex; gap: 0.5rem; }
.se-form-row > * { flex: 1; min-width: 0; }
.se-form-row label { display: block; margin-bottom: 0.25rem; font-size: 0.78rem; color: var(--color-muted); }
.se-people { margin: 0.6rem 0 0; padding: 0; list-style: none; max-height: 360px; overflow-y: auto; }
.se-people li { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.55rem 0; border-bottom: 1px solid var(--color-border); font-size: 0.88rem; }
.se-people li b { font-variant-numeric: tabular-nums; }
.se-people li.is-off { color: var(--color-muted); text-decoration: line-through; }
</style>

<!-- 내 정보 화면처럼 탭과 내용을 하나의 카드 안에 둔다 -->
<div class="container my-card">
<nav class="my-tabs">
    <a href="/update">내 정보</a>
    <a href="/shop/exchange">가게 교환 관리</a>
    <a href="/shop/items">판매 상품 관리</a>
    <a href="/shop/events" class="active">이벤트 관리</a>
</nav>

<div class="se-bar">
    <div class="filter-chip-grid" id="se-tabs">
        <button type="button" class="filter-chip active" data-tab="OPEN">모집중<small id="se-cnt-OPEN"></small></button>
        <button type="button" class="filter-chip" data-tab="CLOSED">마감<small id="se-cnt-CLOSED"></small></button>
        <button type="button" class="filter-chip" data-tab="CANCELLED">취소<small id="se-cnt-CANCELLED"></small></button>
    </div>
    <button type="button" class="write-link" id="se-open-create">이벤트 열기</button>
</div>
<section class="se-panel"><div id="se-list"><p class="se-empty">불러오는 중...</p></div></section>
</div>

<!-- 이벤트 열기 창: 이벤트 상품을 새로 등록하면서 이벤트를 연다 -->
<div class="modal-backdrop" id="se-create-modal" hidden>
    <div class="modal-card">
        <button type="button" class="modal-close" data-close>✕</button>
        <h1>선착순 이벤트 열기</h1>
        <form id="se-form">
            <p>
                <label for="se-shop" class="sr-only">가게</label>
                <select id="se-shop" required>
                    {{#shops}}<option value="{{id}}">{{name}}</option>{{/shops}}
                </select>
            </p>
            <p class="se-section">이벤트 상품</p>
            <p>
                <label for="se-title" class="sr-only">상품명</label>
                <input id="se-title" type="text" placeholder="상품명" maxlength="100" autocomplete="off" required>
            </p>
            <p>
                <label for="se-category" class="sr-only">카테고리</label>
                <select id="se-category" required><option value="">카테고리 선택</option></select>
            </p>
            <p>
                <label for="se-price" class="sr-only">상품 가격</label>
                <span class="price-input">
                    <input id="se-price" type="text" inputmode="numeric" placeholder="상품 가격" autocomplete="off" required>
                    <span class="price-input-unit">원</span>
                </span>
            </p>
            <p>
                <textarea id="se-description" placeholder="상품 설명 (선택)" rows="2"></textarea>
            </p>
            <p class="image-picker">
                <input id="se-image" type="file" class="sr-only" accept="image/jpeg,image/png,image/gif,image/webp">
                <label for="se-image" class="image-picker-btn">이미지 선택</label>
                <span id="se-image-name" class="image-picker-name">선택된 이미지 없음</span>
            </p>
            <p class="se-section">이벤트 조건</p>
            <div class="se-form-row">
                <p>
                    <label for="se-capacity">모집 인원 (1-100명)</label>
                    <input id="se-capacity" type="number" min="1" max="100" placeholder="예: 30" required>
                </p>
                <p>
                    <label for="se-fee">참가비 (5,000-100,000원)</label>
                    <span class="price-input">
                        <input id="se-fee" type="text" inputmode="numeric" placeholder="참가비" autocomplete="off" required>
                        <span class="price-input-unit">원</span>
                    </span>
                </p>
            </div>
            <p>
                <label for="se-deadline" class="se-section" style="display:block;">모집 마감</label>
                <input id="se-deadline" type="datetime-local" required>
            </p>
            <button type="submit" id="se-submit">이벤트 열기</button>
        </form>
        <p id="se-message" class="form-message"></p>
    </div>
</div>

<!-- 참가자 명단 창 -->
<div class="modal-backdrop" id="se-people-modal" hidden>
    <div class="modal-card">
        <button type="button" class="modal-close" data-close>✕</button>
        <h1 id="se-people-title">참가자 명단</h1>
        <ul class="se-people" id="se-people"></ul>
    </div>
</div>

<script>
(() => {
    const pageFetch = (path, options = {}) => fetch(path, Object.assign({ credentials: 'same-origin' }, options));
    const errorText = async (res, fallback) => {
        const text = await res.text();
        try { return JSON.parse(text).message || fallback; } catch (e) { return text || fallback; }
    };
    const money = v => Number(v || 0).toLocaleString('ko-KR') + '원';
    const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const dateTime = iso => iso ? new Date(iso).toLocaleString('ko-KR', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';
    const digits = el => Number(el.value.replace(/\D/g, ''));

    const shopSelect = document.getElementById('se-shop');
    const shopIds = [...shopSelect.options].map(o => Number(o.value));
    const multiShop = shopIds.length > 1;
    if (!multiShop) shopSelect.closest('p').hidden = true;

    const listEl = document.getElementById('se-list');
    let events = [];
    let tab = 'OPEN';

    // 마감시간이 지났으면 상태가 OPEN 이어도(스케줄러 반영 전) 마감으로 본다
    const statusOf = e => e.status === 'OPEN' && new Date(e.deadline) <= new Date() ? 'CLOSED' : e.status;
    const canCancel = e => e.status !== 'CANCELLED' && new Date(e.deadline) > new Date();
    const BADGE = { OPEN: ['모집중', 'is-ok'], CLOSED: ['마감', ''], CANCELLED: ['취소됨', 'is-warn'] };

    function render() {
        ['OPEN', 'CLOSED', 'CANCELLED'].forEach(t => {
            document.getElementById('se-cnt-' + t).textContent = events.filter(e => statusOf(e) === t).length;
        });
        const rows = events.filter(e => statusOf(e) === tab);
        if (!rows.length) {
            const msg = { OPEN: '모집 중인 이벤트가 없어요. 오른쪽 위 이벤트 열기로 시작해 보세요.', CLOSED: '마감된 이벤트가 없어요.', CANCELLED: '취소한 이벤트가 없어요.' }[tab];
            listEl.innerHTML = `<p class="se-empty">${msg}</p>`;
            return;
        }
        listEl.innerHTML = rows.map(e => {
            const [label, cls] = e.currentCount >= e.capacity && statusOf(e) === 'CLOSED' && new Date(e.deadline) > new Date()
                ? ['정원 마감', ''] : BADGE[statusOf(e)];
            return `
            <div class="se-row">
                <span class="related-item-thumb">${e.itemImageUrl ? `<img src="${esc(e.itemImageUrl)}" alt="">` : '🎟️'}</span>
                <span class="se-row-main">
                    <strong><a href="/test/event/${e.id}">${esc(e.itemTitle)}</a></strong>
                    <small>${multiShop ? esc(e.shopName) + ' · ' : ''}상품 ${money(e.itemPrice)} · 참가비 ${money(e.feeAmount)} · ${e.currentCount}/${e.capacity}명</small>
                    <small>마감 ${dateTime(e.deadline)}</small>
                </span>
                <span class="se-actions">
                    <span class="se-badge ${cls}">${label}</span>
                    <button type="button" data-people="${e.id}">참가자</button>
                    ${canCancel(e) ? `<button type="button" data-cancel="${e.id}">이벤트 취소</button>` : ''}
                </span>
            </div>`;
        }).join('');
    }

    async function load() {
        try {
            const lists = await Promise.all(shopIds.map(id => pageFetch('/api/events?shopId=' + id).then(async r => {
                if (!r.ok) throw new Error(await errorText(r, '이벤트를 불러오지 못했어요.'));
                return r.json();
            })));
            events = lists.flat().sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt) || b.id - a.id);
            render();
        } catch (e) {
            listEl.innerHTML = `<p class="se-empty">${esc(e.message)}</p>`;
        }
    }

    document.getElementById('se-tabs').addEventListener('click', ev => {
        const t = ev.target.closest('[data-tab]');
        if (!t) return;
        tab = t.dataset.tab;
        document.querySelectorAll('#se-tabs [data-tab]').forEach(el => el.classList.toggle('active', el === t));
        render();
    });

    // ===== 모달 공통 =====
    document.querySelectorAll('.modal-backdrop').forEach(m => {
        m.addEventListener('click', ev => { if (ev.target === m || ev.target.closest('[data-close]')) m.hidden = true; });
    });

    // ===== 참가자 명단 / 이벤트 취소 =====
    const peopleModal = document.getElementById('se-people-modal');
    const peopleEl = document.getElementById('se-people');
    const PEOPLE_STATUS = { JOINED: '참가', CANCELLED: '참가 취소', REFUNDED: '환불' };
    listEl.addEventListener('click', async ev => {
        const peopleBtn = ev.target.closest('[data-people]');
        const cancelBtn = ev.target.closest('[data-cancel]');
        if (peopleBtn) {
            const e = events.find(x => x.id === Number(peopleBtn.dataset.people));
            document.getElementById('se-people-title').textContent = `${e.itemTitle} 참가자`;
            peopleEl.innerHTML = '<li>불러오는 중...</li>';
            peopleModal.hidden = false;
            const res = await pageFetch(`/api/events/${e.id}/participations`);
            if (!res.ok) { peopleEl.innerHTML = `<li>${esc(await errorText(res, '참가자를 불러오지 못했어요.'))}</li>`; return; }
            const people = await res.json();
            peopleEl.innerHTML = people.length
                ? people.map(p => `<li class="${p.status === 'JOINED' ? '' : 'is-off'}"><span><b>#${p.ticketNumber}</b> ${esc(p.username)}</span><small>${PEOPLE_STATUS[p.status] || p.status}</small></li>`).join('')
                : '<li>아직 참가자가 없어요.</li>';
            return;
        }
        if (cancelBtn) {
            const e = events.find(x => x.id === Number(cancelBtn.dataset.cancel));
            if (!(await gbConfirm(`'${e.itemTitle}' 이벤트를 취소할까요?\n참가자 ${e.currentCount}명의 참가비가 모두 환불돼요.`))) return;
            cancelBtn.disabled = true;
            const res = await pageFetch(`/api/events/${e.id}/cancel`, { method: 'POST' });
            if (!res.ok) await alert(await errorText(res, '이벤트 취소에 실패했습니다.'));
            await load();
        }
    });

    // ===== 이벤트 열기 창 =====
    const createModal = document.getElementById('se-create-modal');
    const form = document.getElementById('se-form');
    const categorySelect = document.getElementById('se-category');
    const imageInput = document.getElementById('se-image');
    const imageName = document.getElementById('se-image-name');
    const message = document.getElementById('se-message');
    const deadlineInput = document.getElementById('se-deadline');
    const fail = text => { message.textContent = text; message.className = 'form-message error'; };

    pageFetch('/api/categories').then(r => r.ok ? r.json() : []).then(list => {
        categorySelect.insertAdjacentHTML('beforeend', list.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join(''));
    });

    // datetime-local 은 로컬 시각 문자열("YYYY-MM-DDTHH:mm")을 쓴다
    const localInput = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);

    document.getElementById('se-open-create').addEventListener('click', () => {
        const keepShop = shopSelect.value;
        form.reset();
        shopSelect.value = keepShop;
        imageName.textContent = '선택된 이미지 없음';
        message.textContent = '';
        const now = new Date();
        deadlineInput.min = localInput(new Date(now.getTime() + 5 * 60000));
        deadlineInput.value = localInput(new Date(now.getTime() + 3 * 86400000));   // 기본 3일 뒤
        createModal.hidden = false;
        document.getElementById('se-title').focus();
    });

    ['se-price', 'se-fee'].forEach(id => {
        const el = document.getElementById(id);
        el.addEventListener('input', () => {
            const d = el.value.replace(/\D/g, '').replace(/^0+/, '');
            el.value = d ? Number(d).toLocaleString('ko-KR') : '';
        });
    });
    imageInput.addEventListener('change', () => {
        imageName.textContent = imageInput.files[0] ? imageInput.files[0].name : '선택된 이미지 없음';
    });

    form.addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!categorySelect.value) { fail('카테고리를 선택해주세요.'); return; }
        const fee = digits(document.getElementById('se-fee'));
        if (fee < 5000 || fee > 100000) { fail('참가비는 5,000원 이상 100,000원 이하로 입력해주세요.'); return; }
        if (!deadlineInput.value || new Date(deadlineInput.value) <= new Date()) { fail('모집 마감은 지금보다 뒤여야 해요.'); return; }
        const submit = document.getElementById('se-submit');
        submit.disabled = true;
        try {
            let imageUrl = null;
            const file = imageInput.files[0];
            if (file) {
                const formData = new FormData();
                formData.append('image', file);
                const up = await pageFetch('/api/items/images', { method: 'POST', body: formData });
                if (!up.ok) { fail(await errorText(up, '이미지 업로드에 실패했습니다.')); return; }
                imageUrl = (await up.json()).imageUrl;
            }
            const body = {
                itemTitle: document.getElementById('se-title').value.trim(),
                categoryId: Number(categorySelect.value),
                itemPrice: digits(document.getElementById('se-price')),
                itemDescription: document.getElementById('se-description').value.trim() || null,
                itemImageUrl: imageUrl,
                capacity: Number(document.getElementById('se-capacity').value),
                feeAmount: fee,
                deadline: deadlineInput.value + ':00'
            };
            const res = await pageFetch(`/api/shops/${shopSelect.value}/events`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
            });
            if (!res.ok) { fail(await errorText(res, '이벤트를 열지 못했습니다.')); return; }
            message.textContent = '이벤트를 열었어요.';
            message.className = 'form-message';
            tab = 'OPEN';
            document.querySelectorAll('#se-tabs [data-tab]').forEach(el => el.classList.toggle('active', el.dataset.tab === 'OPEN'));
            await load();
            setTimeout(() => { createModal.hidden = true; }, 700);
        } finally {
            submit.disabled = false;
        }
    });

    load();
})();
</script>

{{> fragments/footer}}
